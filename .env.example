# Variables de entorno de gesdiweb.
# Copiar este archivo a .env y rellenar con valores reales.
# .env NO se versiona en Git (ver .gitignore).

# El dominio del sitio está fijado en astro.config.mjs (`site`), no es una
# variable de entorno. El schema de env vive en astro.config.mjs#env.schema.

# ─── Resend (formulario de contacto · /api/contact) ───────────
# Crear cuenta y API key en https://resend.com/api-keys
# Verificar el dominio gesdiweb.es con SPF + DKIM + DMARC antes
# de enviar desde "hola@gesdiweb.es".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email "from" verificado en Resend (debe pertenecer al dominio gesdiweb.es)
RESEND_FROM_EMAIL=hola@gesdiweb.es

# Email donde se reciben los leads del formulario
LEAD_NOTIFICATION_EMAIL=hola@gesdiweb.es

# ─── Analítica (Fase futura) ──────────────────────────────────
# PUBLIC_PLAUSIBLE_DOMAIN=gesdiweb.es

# ─── Despliegue (Fase 7) ──────────────────────────────────────
# GHCR_TOKEN=
