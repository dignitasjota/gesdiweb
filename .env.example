# Variables de entorno de gesdiweb
# Copiar este archivo a .env y rellenar con valores reales.
# .env NO se versiona en Git (ver .gitignore).

# ─── Astro / sitio ──────────────────────────────────────────
PUBLIC_SITE_URL=https://gesdiweb.es

# ─── Resend (Fase 5 — formulario de contacto) ───────────────
# Obtener API key en https://resend.com/api-keys
RESEND_API_KEY=
# Email "from" verificado en Resend (debe pertenecer al dominio gesdiweb.es)
RESEND_FROM_EMAIL=hola@gesdiweb.es
# Email donde recibimos los leads
LEAD_NOTIFICATION_EMAIL=

# ─── Analítica (Fase futura) ────────────────────────────────
# PUBLIC_PLAUSIBLE_DOMAIN=gesdiweb.es

# ─── Despliegue (Fase 8) ────────────────────────────────────
# GHCR_TOKEN=
