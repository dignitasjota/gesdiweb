---
/**
 * Wrapper semántico que marca un elemento para fade-up al hacer scroll.
 * El movimiento real lo aplica el controller GSAP en SmoothScroll.astro
 * leyendo `[data-reveal]` desde el DOM.
 *
 * Props:
 *   - as: tag HTML (div por defecto)
 *   - delay: ms de retraso adicional
 *   - y: distancia de translación inicial en px (24 por defecto)
 *   - stagger: si es true, los hijos directos animarán en cascada
 */

interface Props {
  as?: keyof HTMLElementTagNameMap;
  delay?: number;
  y?: number;
  stagger?: boolean;
  class?: string;
}

const {
  as: Tag = 'div',
  delay = 0,
  y = 24,
  stagger = false,
  class: className = '',
} = Astro.props;
---

<Tag
  class={className}
  data-reveal
  data-reveal-delay={delay}
  data-reveal-y={y}
  data-reveal-stagger={stagger ? 'true' : undefined}
>
  <slot />
</Tag>
