---
/**
 * Wrapper que monta:
 *   - Lenis para smooth scroll global
 *   - IntersectionObserver para reveals al entrar en viewport
 *
 * Respeta prefers-reduced-motion: si está activo, ni Lenis ni los reveals
 * se inicializan (los elementos quedan visibles desde el primer paint
 * gracias al CSS de fallback).
 *
 * Para animar elementos al scroll, usar <Reveal> (no requiere JS extra, solo
 * CSS transitions disparadas por una clase vía IntersectionObserver).
 */
---

<script>
  import Lenis from 'lenis';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let lenis: Lenis | null = null;

  function setupAnimations() {
    if (reduceMotion) {
      // El CSS ya muestra todo. Nada que hacer.
      return;
    }

    // Guarda: si ya hay una instancia viva no creamos otra (evita dos Lenis
    // y dos bucles raf que acelerarían el scroll).
    if (lenis) return;

    // ── Lenis smooth scroll ────────────────────────────────────
    lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.4,
    });

    function raf(time: number) {
      if (lenis) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
    }
    requestAnimationFrame(raf);

    document.documentElement.classList.add('lenis-smooth');

    // ── Reveals con IntersectionObserver (sin GSAP) ────────────
    const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.revealDelay || 0);
          const isStagger = el.dataset.revealStagger === 'true';

          if (isStagger) {
            // Aplicar delay incremental a cada hijo
            const children = Array.from(el.children).filter(
              (c): c is HTMLElement => c instanceof HTMLElement,
            );
            children.forEach((child, i) => {
              child.style.setProperty('--stagger-delay', `${delay + i * 80}ms`);
            });
          } else if (delay > 0) {
            el.style.transitionDelay = `${delay}ms`;
          }

          el.classList.add('is-visible');
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );

    reveals.forEach((el) => io.observe(el));
  }

  function cleanup() {
    if (lenis) {
      lenis.destroy();
      lenis = null;
    }
    document.documentElement.classList.remove('lenis-smooth');
  }

  // La inicialización va SOLO en astro:page-load (que también dispara en la
  // carga inicial); llamarla además de forma directa crearía dos instancias de
  // Lenis. cleanup se ata en before-swap para destruir la instancia previa.
  document.addEventListener('astro:before-swap', cleanup);
  document.addEventListener('astro:page-load', setupAnimations);
</script>
