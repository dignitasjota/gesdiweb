---
interface Props {
  value: string;
  label: string;
  suffix?: string;
  class?: string;
}

const { value, label, suffix, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-3 ${className}`}>
  <p
    class="font-display font-bold tracking-tight leading-none"
    style="font-size: var(--text-2xl);"
  >
    {value}
    {suffix && <span class="text-[--color-brand]">{suffix}</span>}
  </p>
  <p class="text-sm text-[--color-fg-soft] max-w-[20ch]">{label}</p>
</div>
