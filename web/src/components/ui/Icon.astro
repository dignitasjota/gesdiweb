---
/**
 * Librería de iconos SVG inline. Estilo: stroke 1.5px, esquinas redondeadas,
 * inspirado en Lucide pero con personalidad propia (más geométrico).
 * Todos los iconos heredan currentColor.
 *
 * El tipo IconName vive en ./icon-names.ts (Astro frontmatter no soporta
 * `export type` directamente).
 */

import type { IconName } from './icon-names';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}

const {
  name,
  size = 24,
  class: className = '',
  strokeWidth = 1.5,
  ariaLabel,
} = Astro.props;

const role = ariaLabel ? 'img' : undefined;
const ariaHidden = ariaLabel ? undefined : 'true';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={role}
  aria-label={ariaLabel}
  aria-hidden={ariaHidden}
>
  {name === 'seo' && (
    <>
      <circle cx="11" cy="11" r="6" />
      <line x1="15.5" y1="15.5" x2="20" y2="20" />
      <path d="M9 11l1.5 1.5L13 10" />
    </>
  )}
  {name === 'mobile' && (
    <>
      <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
      <line x1="10" y1="18" x2="14" y2="18" />
      <line x1="11" y1="6" x2="13" y2="6" />
    </>
  )}
  {name === 'server' && (
    <>
      <rect x="3" y="4" width="18" height="6" rx="1.5" />
      <rect x="3" y="14" width="18" height="6" rx="1.5" />
      <line x1="6.5" y1="7" x2="6.5" y2="7.01" />
      <line x1="6.5" y1="17" x2="6.5" y2="17.01" />
      <line x1="10" y1="7" x2="14" y2="7" />
      <line x1="10" y1="17" x2="14" y2="17" />
    </>
  )}
  {name === 'megaphone' && (
    <>
      <path d="M3 11l11-6v14l-11-6z" />
      <path d="M14 8a3 3 0 010 6" />
      <path d="M7 14v3a2 2 0 002 2v-3" />
    </>
  )}
  {name === 'wrench' && (
    <>
      <path d="M14 6a4 4 0 00-5.657 5.657l-4.95 4.95a1.5 1.5 0 002.121 2.121l4.95-4.95A4 4 0 0014 6z" />
      <circle cx="14" cy="6" r="1" fill="currentColor" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="1.5" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
      <line x1="8" y1="3" x2="8" y2="6.5" />
      <line x1="16" y1="3" x2="16" y2="6.5" />
    </>
  )}
  {name === 'grid' && (
    <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="1" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="1" />
    </>
  )}
  {name === 'repeat' && (
    <>
      <polyline points="17 1 21 5 17 9" />
      <path d="M3 11V9a4 4 0 014-4h14" />
      <polyline points="7 23 3 19 7 15" />
      <path d="M21 13v2a4 4 0 01-4 4H3" />
    </>
  )}
  {name === 'bolt' && (
    <>
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
    </>
  )}
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polygon points="16 8 14 14 8 16 10 10 16 8" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'map' && (
    <>
      <polygon points="3 6 9 4 15 6 21 4 21 18 15 20 9 18 3 20 3 6" />
      <line x1="9" y1="4" x2="9" y2="18" />
      <line x1="15" y1="6" x2="15" y2="20" />
    </>
  )}
  {name === 'pen' && (
    <>
      <path d="M14 4l6 6-9.5 9.5L4 21l1.5-6.5z" />
      <line x1="14" y1="4" x2="20" y2="10" />
    </>
  )}
  {name === 'rocket' && (
    <>
      <path d="M12 2c4 4 6 8 6 12l-3 3-6-6 3-3c4 0 4-2 0-6z" />
      <path d="M9 15l-3 3 0 3 3 0 3-3" />
      <circle cx="14" cy="9" r="1.2" fill="currentColor" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 2.5l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10v-6z" />
      <path d="M9.5 12l2 2 3.5-4" />
    </>
  )}
  {name === 'leaf' && (
    <>
      <path d="M5 19c10 0 16-6 16-16-10 0-16 6-16 16z" />
      <line x1="5" y1="19" x2="13" y2="11" />
    </>
  )}
  {name === 'check' && (
    <>
      <polyline points="4 12 10 18 20 6" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === 'arrow-up-right' && (
    <>
      <line x1="7" y1="17" x2="17" y2="7" />
      <polyline points="7 7 17 7 17 17" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <line x1="4" y1="12" x2="20" y2="12" />
      <polyline points="14 6 20 12 14 18" />
    </>
  )}
  {name === 'play' && (
    <>
      <polygon points="6 4 20 12 6 20 6 4" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <polyline points="3 7 12 13 21 7" />
    </>
  )}
  {name === 'phone' && (
    <>
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A14 14 0 014 6a2 2 0 012-2z" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z" />
      <circle cx="12" cy="9" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polyline points="12 7 12 12 15.5 14" />
    </>
  )}
  {name === 'sparkle' && (
    <>
      <path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z" />
    </>
  )}
</svg>
