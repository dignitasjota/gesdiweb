---
import Marker from '../ui/Marker.astro';
import Badge from '../ui/Badge.astro';

const steps = [
  {
    title: 'Descubrimiento',
    description:
      'Reunión inicial, análisis de objetivos, competencia y limitaciones reales. Sin esta fase no se diseña una sola línea.',
  },
  {
    title: 'Estrategia',
    description:
      'Plan claro: qué se hace, en qué orden, con qué métricas y con qué presupuesto. Documento firmado por ambas partes.',
  },
  {
    title: 'Diseño y desarrollo',
    description:
      'Iteraciones quincenales con builds reales que ya puedes tocar. Diseño UI, desarrollo front y back, y SEO técnico desde el día 1.',
  },
  {
    title: 'Lanzamiento y crecimiento',
    description:
      'Go-live ordenado, monitorización las primeras semanas y plan de mantenimiento + crecimiento que activa el siguiente ciclo.',
  },
];
---

<section class="bg-[--color-bg-inverse] text-[--color-fg-inverse]">
  <div class="container-fluid section-spacing">
    <Marker label="00.06° proceso" variant="inverse" />

    <h2
      class="mt-6 font-display font-bold tracking-tight leading-[0.95] max-w-[20ch]"
      style="font-size: var(--text-2xl);"
    >
      Cuatro pasos. Cero atajos.
    </h2>

    <ol class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
      {steps.map((step, i) => (
        <li class="flex flex-col gap-5">
          <div class="flex items-center justify-between">
            <Badge number={i + 1} />
            <span
              class="h-px flex-1 ml-6 bg-white/15"
              aria-hidden="true"
            ></span>
          </div>
          <h3
            class="font-display font-bold tracking-tight leading-tight"
            style="font-size: var(--text-xl);"
          >
            {step.title}
          </h3>
          <p class="text-[--color-muted] leading-relaxed max-w-[45ch]">
            {step.description}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
