---
import Marker from '../ui/Marker.astro';
import StatBlock from '../ui/StatBlock.astro';
---

<section class="container-fluid section-spacing">
  <Marker label="00.05° en cifras" />

  <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-16">
    <StatBlock value="10" suffix="+" label="años acompañando proyectos" />
    <StatBlock value="120" label="webs y apps entregadas" />
    <StatBlock value="98" suffix="%" label="clientes que repiten" />
    <StatBlock value="100%" label="español, atención humana" />
  </div>

  <p class="mt-12 max-w-2xl text-sm text-[--color-muted] font-mono">
    // [PLACEHOLDER] cifras provisionales · pendientes de confirmación con datos reales
  </p>
</section>
