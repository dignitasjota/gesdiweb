---
import Marker from '../ui/Marker.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icon-names';

const stats: { value: string; suffix: string; label: string; icon: IconName }[] = [
  { value: '10', suffix: '+', label: 'años acompañando proyectos', icon: 'calendar' },
  { value: '120', suffix: '', label: 'webs y apps entregadas', icon: 'grid' },
  { value: '98', suffix: '%', label: 'clientes que repiten', icon: 'repeat' },
  { value: '24', suffix: 'h', label: 'tiempo medio de respuesta', icon: 'bolt' },
];
---

<section class="bg-[--color-bg-inverse] text-[--color-fg-inverse]">
  <div class="container-fluid section-spacing">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div>
        <Marker label="00.05° en cifras" variant="inverse" />
        <h2
          class="mt-5 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[20ch]"
          style="font-size: var(--text-2xl);"
        >
          Diez años. <span class="text-[--color-brand]">Cero humo</span>.
        </h2>
      </div>
      <p
        class="font-mono uppercase tracking-widest text-white/50"
        style="font-size: var(--text-xs);"
      >
        // [PLACEHOLDER] cifras provisionales
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 rounded-2xl overflow-hidden">
      {stats.map((s) => (
        <div class="bg-[--color-bg-inverse] p-7 md:p-10 flex flex-col gap-5">
          <span
            class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[--color-brand]/15 text-[--color-brand] border border-[--color-brand]/30"
            aria-hidden="true"
          >
            <Icon name={s.icon} size={20} />
          </span>
          <p
            class="font-display font-bold tracking-[-0.03em] leading-none text-[--color-brand] mt-auto"
            style="font-size: var(--text-3xl);"
          >
            {s.value}<span class="text-[--color-fg-inverse]">{s.suffix}</span>
          </p>
          <p
            class="text-white/70 max-w-[20ch]"
            style="font-size: var(--text-sm);"
          >
            {s.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
