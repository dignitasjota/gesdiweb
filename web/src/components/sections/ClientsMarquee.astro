---
import Marker from '../ui/Marker.astro';

// Placeholder. En Fase 2 final cuando el dueño aporte los SVGs reales,
// se pasarán a /public/clients/*.svg y se renderizarán como <Image>.
const placeholders = [
  '[CLIENTE 01]',
  '[CLIENTE 02]',
  '[CLIENTE 03]',
  '[CLIENTE 04]',
  '[CLIENTE 05]',
  '[CLIENTE 06]',
];
---

<section class="border-y border-[--color-border-soft] py-10 md:py-14 bg-[--color-bg-soft] overflow-hidden">
  <div class="container-fluid mb-6">
    <Marker label="confían en nosotros" />
  </div>

  <div class="flex items-center gap-12 md:gap-20 px-8 whitespace-nowrap">
    {placeholders.concat(placeholders).map((label) => (
      <span class="font-mono uppercase tracking-widest text-sm text-[--color-muted]">
        {label}
      </span>
    ))}
  </div>
</section>
