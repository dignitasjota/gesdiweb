---
import Marker from '../ui/Marker.astro';
import Tag from '../ui/Tag.astro';
import { getRecentPosts, formatDateLong } from '../../data/posts';

const posts = getRecentPosts(3);
---

<section class="container-fluid section-spacing">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
    <div>
      <Marker label="00.08° blog" />
      <h2
        class="mt-5 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[22ch]"
        style="font-size: var(--text-2xl);"
      >
        Lo último <span class="text-[--color-brand]">que pensamos</span>.
      </h2>
    </div>
    <a
      href="/blog"
      class="font-mono text-xs uppercase tracking-widest text-[--color-fg-soft] hover:text-[--color-fg] transition-colors self-start md:self-auto"
    >
      ver todos los posts →
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {posts.map((post, i) => (
      <a href={`/blog/${post.slug}`} class="group flex flex-col gap-5">
        <div
          class={`aspect-[4/3] rounded-2xl flex items-center justify-center font-mono uppercase tracking-widest border-2 border-transparent transition-colors ${
            i === 0
              ? 'bg-[--color-brand] text-[--color-fg-inverse] group-hover:border-[--color-brand-hover]'
              : 'bg-[--color-brand-soft] text-[--color-brand-hover] group-hover:border-[--color-brand]'
          }`}
          aria-hidden="true"
          style="font-size: var(--text-xs);"
        >
          [PLACEHOLDER · cover]
        </div>
        <div class="flex items-center gap-2">
          {post.categories.slice(0, 1).map((cat) => (
            <Tag label={cat} variant="brand" />
          ))}
          <span class="font-mono text-xs text-[--color-muted]">
            · {post.readingMinutes} min
          </span>
        </div>
        <h3
          class="font-display font-bold tracking-[-0.02em] leading-tight group-hover:text-[--color-brand-hover] transition-colors"
          style="font-size: var(--text-lg);"
        >
          {post.title}
        </h3>
        <p class="text-[--color-fg-soft] line-clamp-3">
          {post.excerpt}
        </p>
        <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted] mt-auto">
          <time datetime={post.publishedAt}>{formatDateLong(post.publishedAt)}</time>
        </p>
      </a>
    ))}
  </div>
</section>
