---
import Marker from '../ui/Marker.astro';
import Button from '../ui/Button.astro';
---

<section class="container-fluid section-spacing">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
    <div class="md:col-span-7">
      <Marker label="00.07° contacto directo" />
      <h2
        class="mt-6 font-display font-bold tracking-[-0.03em] leading-[0.92] max-w-[14ch]"
        style="font-size: var(--text-3xl);"
      >
        Cuéntame tu<br />
        <span class="text-[--color-brand]">proyecto</span>.
      </h2>
      <p
        class="mt-10 text-[--color-fg-soft] leading-relaxed max-w-xl"
        style="font-size: var(--text-lg);"
      >
        Cuarenta minutos por videollamada. Te diré con honestidad si puedo
        ayudarte y, si no, a quién acudir. Sin compromiso ninguno.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/contacto" variant="primary" size="lg">Reservar llamada</Button>
        <Button href="mailto:hola@gesdiweb.es" variant="ghost" size="lg">
          hola@gesdiweb.es
        </Button>
      </div>
    </div>

    <div class="md:col-span-5">
      <div
        class="aspect-square w-full max-w-md bg-[--color-brand-soft] rounded-2xl flex items-center justify-center text-[--color-brand-hover] font-mono uppercase tracking-widest border-2 border-[--color-brand] relative overflow-hidden"
        aria-hidden="true"
      >
        <span
          class="absolute top-6 left-6 font-mono text-[--color-brand-hover]"
          style="font-size: var(--text-xs);"
        >
          // jota
        </span>
        <span
          class="absolute bottom-6 right-6 font-mono text-[--color-brand-hover]"
          style="font-size: var(--text-xs);"
        >
          fundador
        </span>
        <p style="font-size: var(--text-sm);">[PLACEHOLDER · foto]</p>
      </div>
      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-[--color-muted]">
        // único contacto durante todo el proyecto
      </p>
    </div>
  </div>
</section>
