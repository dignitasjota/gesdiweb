---
/**
 * Hero principal: título gigantesco con palabra rotativa cambiante y
 * disco "morphing" decorativo. Información contextual en la parte
 * inferior con 3 columnas y un scroll hint.
 */
const swapWords = ['posicionamiento', 'identidad', 'rendimiento', 'conversión', 'accesibilidad'];
---

<section class="hero" id="top">
  <div class="hero-top">
    <div>
      <span class="hero-label">Agencia independiente</span>
      <span>España · Atención remota · Desde 2009</span>
    </div>
    <div>
      <span class="hero-label">Disponibilidad</span>
      <span>Aceptando proyectos · Q3 2026</span>
    </div>
    <div class="hero-top-right">
      <span class="hero-label">v.06</span>
      <span>Diseño web · SEO · Hosting</span>
    </div>
  </div>

  <h1 class="hero-title">
    <span class="hero-row">
      <span class="hero-word d1">Diseñamos</span>
      <span class="hero-word d2">webs</span>
      <span class="hero-disc disc-morph" aria-hidden="true"></span>
    </span>
    <span class="hero-row hero-row-indent">
      <span class="hero-word d3">
        <span class="hero-swap" aria-hidden="true">
          {
            swapWords.map((w, i) => (
              <span class="hero-swap-item" data-i={i}>
                <em>{w}</em>
              </span>
            ))
          }
        </span>
        <span class="sr-only">{swapWords.join(', ')}</span>
      </span>
      <span class="hero-word d4">para</span>
      <span class="hero-word d5">negocios&nbsp;que&nbsp;crecen.</span>
    </span>
  </h1>

  <div class="hero-bottom">
    <div class="hero-col">
      <span class="hero-arrow">↘ Manifiesto</span>
      <p>
        Una agencia obsesionada con el detalle. Diseño y código en la misma mesa, sin
        intermediarios, sin maquilladas que no convierten.
      </p>
    </div>
    <div class="hero-col">
      <span class="hero-arrow">↘ Qué hacemos</span>
      <p>Diseño web · Posicionamiento SEO · Apps móviles · Hosting · Marketing online</p>
    </div>
    <div class="hero-col hero-col-end">
      <span>Baja para empezar</span>
      <svg
        class="hero-scroll-arrow"
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        aria-hidden="true"
      >
        <path d="M7 1V13M7 13L1 7M7 13L13 7" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 64px);
    padding: 80px 32px 60px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 800px) {
    .hero {
      min-height: calc(100vh - 80px);
      padding: 100px 32px 60px;
    }
  }

  .hero-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }
  @media (min-width: 700px) {
    .hero-top {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .hero-top > div {
    display: flex;
    flex-direction: column;
  }
  .hero-top-right {
    text-align: left;
  }
  @media (min-width: 700px) {
    .hero-top-right {
      text-align: right;
    }
  }
  .hero-label {
    color: var(--color-fg);
    margin-bottom: 4px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display-hero);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }
  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25em 0.4em;
    overflow: visible;
  }
  .hero-row-indent {
    padding-left: 8vw;
  }
  @media (max-width: 700px) {
    .hero-row-indent {
      padding-left: 0;
    }
  }

  .hero-word {
    display: inline-block;
    transform: translateY(110%);
    animation: hero-rise 1.1s var(--ease-out) forwards;
  }
  .hero-word.d1 {
    animation-delay: 0.05s;
  }
  .hero-word.d2 {
    animation-delay: 0.15s;
  }
  .hero-word.d3 {
    animation-delay: 0.25s;
  }
  .hero-word.d4 {
    animation-delay: 0.35s;
  }
  .hero-word.d5 {
    animation-delay: 0.45s;
  }

  @keyframes hero-rise {
    to {
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      transform: none !important;
      animation: none !important;
    }
  }

  .hero-disc {
    width: clamp(70px, 9vw, 130px);
    height: clamp(70px, 9vw, 130px);
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  /* Word swap rotativo */
  .hero-swap {
    position: relative;
    display: inline-block;
    vertical-align: top;
    min-width: 9ch;
    height: 1em;
    overflow: hidden;
  }
  .hero-swap-item {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transform: translateY(110%);
    animation: hero-swap-cycle 12s var(--ease-out) infinite;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-brand);
    letter-spacing: -0.02em;
  }
  .hero-swap-item[data-i='0'] {
    animation-delay: 0s;
  }
  .hero-swap-item[data-i='1'] {
    animation-delay: 2.4s;
  }
  .hero-swap-item[data-i='2'] {
    animation-delay: 4.8s;
  }
  .hero-swap-item[data-i='3'] {
    animation-delay: 7.2s;
  }
  .hero-swap-item[data-i='4'] {
    animation-delay: 9.6s;
  }
  @keyframes hero-swap-cycle {
    0%,
    18% {
      opacity: 0;
      transform: translateY(110%);
    }
    2%,
    16% {
      opacity: 1;
      transform: translateY(0);
    }
    20%,
    100% {
      opacity: 0;
      transform: translateY(-110%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-swap-item {
      animation: none !important;
      opacity: 0;
      transform: none;
    }
    .hero-swap-item[data-i='0'] {
      opacity: 1;
    }
  }

  /* Bottom info row */
  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: end;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }
  @media (min-width: 800px) {
    .hero-bottom {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 40px;
      padding-top: 40px;
    }
  }
  .hero-col p {
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.5;
    margin: 8px 0 0;
    max-width: 36ch;
  }
  .hero-col-end {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  @media (min-width: 800px) {
    .hero-col-end {
      justify-content: flex-end;
    }
  }
  .hero-scroll-arrow {
    animation: hero-bounce 2s ease-in-out infinite;
  }
  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-arrow {
      animation: none !important;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
