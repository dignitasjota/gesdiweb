---
import Marker from '../ui/Marker.astro';
import Tag from '../ui/Tag.astro';
import Reveal from '../animations/Reveal.astro';
import { getFeaturedProjects } from '../../lib/collections';

const featured = await getFeaturedProjects();
---

<section class="container-fluid section-spacing">
  <Reveal class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
    <div>
      <Marker label="00.04° trabajo reciente" />
      <h2
        class="mt-5 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[22ch]"
        style="font-size: var(--text-2xl);"
      >
        Proyectos que <span class="text-[--color-brand]">han crecido</span> con nosotros.
      </h2>
    </div>
    <a
      href="/portfolio"
      class="font-mono text-xs uppercase tracking-widest text-[--color-fg-soft] hover:text-[--color-fg] transition-colors self-start md:self-auto"
    >
      ver portfolio completo →
    </a>
  </Reveal>

  <Reveal class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12" stagger>
    {featured.map((project, i) => (
      <a
        href={`/portfolio/${project.id}`}
        class={`group flex flex-col gap-5 ${i === 0 ? 'md:col-span-2' : ''}`}
      >
        <div
          class={`bg-[--color-brand-soft] rounded-2xl overflow-hidden flex items-center justify-center text-[--color-brand-hover] font-mono uppercase tracking-widest border-2 border-transparent group-hover:border-[--color-brand] transition-colors relative ${
            i === 0 ? 'aspect-[16/8]' : 'aspect-[4/3]'
          }`}
          aria-hidden="true"
        >
          <div class="text-center">
            <div
              class="w-14 h-14 rounded-full bg-[--color-brand] flex items-center justify-center mx-auto mb-4"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </div>
            <p style="font-size: var(--text-sm);">[PLACEHOLDER · {project.data.title}]</p>
          </div>
          <span
            class="absolute top-6 left-6 font-mono text-[--color-brand-hover]"
            style="font-size: var(--text-xs);"
          >
            /{String(project.data.order).padStart(2, '0')}
          </span>
          <span
            class="absolute top-6 right-6 font-mono text-[--color-brand-hover]"
            style="font-size: var(--text-xs);"
          >
            {project.data.year}
          </span>
        </div>
        <div class="flex items-baseline justify-between gap-4">
          <h3
            class="font-display font-bold tracking-[-0.02em] group-hover:text-[--color-brand-hover] transition-colors"
            style="font-size: var(--text-xl);"
          >
            {project.data.title}
          </h3>
        </div>
        <p class="text-[--color-fg-soft] max-w-[55ch]">
          {project.data.excerpt}
        </p>
        <div class="flex flex-wrap gap-2">
          {project.data.techStack.slice(0, 3).map((tech) => (
            <Tag label={tech} />
          ))}
        </div>
      </a>
    ))}
  </Reveal>
</section>
