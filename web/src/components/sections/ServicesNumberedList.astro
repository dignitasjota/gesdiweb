---
import Marker from '../ui/Marker.astro';
import { getOrderedServices } from '../../data/services';

const services = getOrderedServices();
const [primary, ...rest] = services;

// Iconos sintéticos por slug (placeholder hasta tener SVG reales)
const icons: Record<string, string> = {
  'posicionamiento-web': '◐',
  'apps-moviles': '▣',
  'hosting-web': '◇',
  'marketing-online': '✦',
  'mantenimiento-informatico': '◈',
};
---

<section class="bg-[--color-bg-soft] border-y border-[--color-border-soft]">
  <div class="container-fluid section-spacing">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div>
        <Marker label="00.03° servicios" />
        <h2
          class="mt-5 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[20ch]"
          style="font-size: var(--text-2xl);"
        >
          Cinco maneras de <span class="text-[--color-brand]">crecer</span>.
        </h2>
      </div>
      <a
        href="/servicios"
        class="font-mono text-xs uppercase tracking-widest text-[--color-fg-soft] hover:text-[--color-fg] transition-colors self-start md:self-auto"
      >
        ver todos los servicios →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
      {/* Card destacada · ocupa toda la fila */}
      <a
        href={`/servicios/${primary.slug}`}
        class="group md:col-span-2 bg-[--color-brand] text-[--color-fg-inverse] rounded-2xl p-8 md:p-12 flex flex-col md:flex-row md:items-end gap-8 md:gap-16 transition-transform hover:-translate-y-1"
      >
        <div class="flex-1">
          <div class="flex items-center gap-4 mb-6">
            <span
              class="font-mono uppercase tracking-widest text-white/70"
              style="font-size: var(--text-xs);"
            >
              /01 · destacado
            </span>
          </div>
          <h3
            class="font-display font-bold tracking-[-0.025em] leading-[0.95]"
            style="font-size: var(--text-2xl);"
          >
            {primary.title}
          </h3>
          <p
            class="mt-5 max-w-2xl text-white/85 leading-relaxed"
            style="font-size: var(--text-base);"
          >
            {primary.headline} {primary.excerpt}
          </p>
        </div>
        <div class="flex items-center justify-between md:justify-end gap-8 md:gap-12">
          <span
            class="font-display font-bold leading-none select-none"
            style="font-size: clamp(4rem, 10vw, 8rem); color: rgba(255,255,255,0.25);"
            aria-hidden="true"
          >
            {icons[primary.slug]}
          </span>
          <span
            class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[--color-fg-inverse] text-[--color-brand] group-hover:scale-110 transition-transform shrink-0"
            aria-hidden="true"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </span>
        </div>
      </a>

      {/* 4 cards restantes en 2x2 */}
      {rest.map((service) => (
        <a
          href={`/servicios/${service.slug}`}
          class="group bg-[--color-bg] border border-[--color-border] rounded-2xl p-7 md:p-9 flex flex-col gap-5 transition-all hover:-translate-y-1 hover:border-[--color-brand] hover:bg-[--color-brand-soft]"
        >
          <div class="flex items-start justify-between gap-4">
            <span
              class="font-mono uppercase tracking-widest text-[--color-muted] group-hover:text-[--color-brand-hover] transition-colors"
              style="font-size: var(--text-xs);"
            >
              /{String(service.order).padStart(2, '0')}
            </span>
            <span
              class="font-display font-bold leading-none text-[--color-brand] select-none"
              style="font-size: clamp(2.5rem, 5vw, 4rem);"
              aria-hidden="true"
            >
              {icons[service.slug]}
            </span>
          </div>

          <h3
            class="font-display font-bold tracking-[-0.02em] leading-tight mt-2 group-hover:text-[--color-brand-hover] transition-colors"
            style="font-size: var(--text-xl);"
          >
            {service.title}
          </h3>

          <p class="text-[--color-fg-soft] leading-relaxed flex-1">
            {service.excerpt}
          </p>

          <div class="flex items-center justify-between pt-4 border-t border-[--color-border-soft]">
            <span
              class="font-mono uppercase tracking-widest text-[--color-fg-soft] group-hover:text-[--color-brand-hover] transition-colors"
              style="font-size: var(--text-xs);"
            >
              ver detalle
            </span>
            <span
              class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[--color-bg-soft] text-[--color-fg] group-hover:bg-[--color-brand] group-hover:text-[--color-fg-inverse] transition-colors"
              aria-hidden="true"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
