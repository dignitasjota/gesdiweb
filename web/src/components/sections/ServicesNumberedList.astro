---
import Marker from '../ui/Marker.astro';
import { getOrderedServices } from '../../data/services';

const services = getOrderedServices();
---

<section class="bg-[--color-bg-soft] border-y border-[--color-border-soft]">
  <div class="container-fluid section-spacing">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
      <div>
        <Marker label="00.03° servicios" />
        <h2
          class="mt-6 font-display font-bold tracking-[-0.03em] leading-[0.95] max-w-[18ch]"
          style="font-size: var(--text-2xl);"
        >
          Cinco maneras<br />
          de hacer<br />
          <span class="text-[--color-brand]">crecer tu proyecto</span>.
        </h2>
      </div>
      <a
        href="/servicios"
        class="font-mono text-xs uppercase tracking-widest text-[--color-fg-soft] hover:text-[--color-fg] transition-colors self-start md:self-auto"
      >
        ver todos los servicios →
      </a>
    </div>
  </div>

  <ul class="border-t border-[--color-border]">
    {services.map((service) => (
      <li class="border-b border-[--color-border]">
        <a
          href={`/servicios/${service.slug}`}
          class="group block transition-colors duration-300 hover:bg-[--color-brand-soft]"
        >
          <div class="container-fluid flex flex-col md:flex-row md:items-center gap-4 md:gap-12 py-10 md:py-14">
            <span
              class="font-mono text-[--color-muted] group-hover:text-[--color-brand-hover] transition-colors shrink-0 md:w-16"
              style="font-size: var(--text-sm);"
            >
              /{String(service.order).padStart(2, '0')}
            </span>
            <h3
              class="font-display font-bold tracking-[-0.03em] leading-tight flex-1 group-hover:text-[--color-brand-hover] transition-colors"
              style="font-size: var(--text-2xl);"
            >
              {service.title}
            </h3>
            <p class="text-[--color-fg-soft] md:max-w-md md:text-right group-hover:text-[--color-fg] transition-colors">
              {service.excerpt}
            </p>
            <span
              class="font-mono uppercase tracking-widest text-[--color-muted] group-hover:text-[--color-brand-hover] group-hover:translate-x-2 transition-all shrink-0"
              style="font-size: var(--text-xs);"
              aria-hidden="true"
            >
              →
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
