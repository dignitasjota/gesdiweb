---
import Marker from '../ui/Marker.astro';
import Badge from '../ui/Badge.astro';
import { getOrderedServices } from '../../data/services';

const services = getOrderedServices();
---

<section class="bg-[--color-bg-soft] border-y border-[--color-border-soft]">
  <div class="container-fluid section-spacing">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
      <div>
        <Marker label="00.03° servicios" />
        <h2
          class="mt-4 font-display font-bold tracking-tight leading-[0.95] max-w-[18ch]"
          style="font-size: var(--text-2xl);"
        >
          Cinco maneras de hacer crecer tu proyecto.
        </h2>
      </div>
      <a
        href="/servicios"
        class="font-mono text-xs uppercase tracking-widest text-[--color-fg-soft] hover:text-[--color-fg] transition-colors self-start md:self-auto"
      >
        ver todos los servicios →
      </a>
    </div>

    <ul class="divide-y divide-[--color-border]">
      {services.map((service) => (
        <li>
          <a
            href={`/servicios/${service.slug}`}
            class="group flex flex-col md:flex-row md:items-center gap-4 md:gap-12 py-8 md:py-10 transition-colors"
          >
            <Badge number={service.order} class="md:w-16 shrink-0" />
            <h3
              class="font-display font-bold tracking-tight leading-tight flex-1 group-hover:text-[--color-brand] transition-colors"
              style="font-size: var(--text-xl);"
            >
              {service.title}
            </h3>
            <p class="text-[--color-fg-soft] md:max-w-md md:text-right text-sm md:text-base">
              {service.excerpt}
            </p>
            <span
              class="font-mono text-xs uppercase tracking-widest text-[--color-muted] group-hover:text-[--color-brand] transition-colors"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
