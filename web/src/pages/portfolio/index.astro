---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marker from '../../components/ui/Marker.astro';
import Tag from '../../components/ui/Tag.astro';
import { getAllProjects } from '../../lib/collections';

const allProjects = await getAllProjects();
---

<BaseLayout
  title="Portfolio · gesdiweb"
  description="Proyectos recientes de diseño web, apps móviles y posicionamiento SEO."
>
  <section class="container-fluid pt-12 md:pt-20 pb-16 md:pb-24">
    <Marker label="02.portfolio" />
    <h1
      class="mt-8 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[18ch]"
      style="font-size: var(--text-3xl);"
    >
      Trabajo reciente.<br />
      <span class="text-[--color-brand]">Resultados</span> reales.
    </h1>
    <p
      class="mt-8 max-w-2xl text-[--color-fg-soft] leading-relaxed"
      style="font-size: var(--text-lg);"
    >
      Selección curada de proyectos. Cada caso de estudio incluye los retos
      reales, las decisiones técnicas y las métricas que los acompañan.
    </p>
  </section>

  <section class="border-t border-[--color-border]">
    <div class="container-fluid py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-24">
        {allProjects.map((project, i) => (
          <a
            href={`/portfolio/${project.id}`}
            class={`group flex flex-col gap-5 ${
              i % 3 === 0 ? 'md:col-span-2' : ''
            }`}
          >
            <div
              class={`bg-[--color-brand-soft] rounded-2xl overflow-hidden flex items-center justify-center text-[--color-brand-hover] font-mono uppercase tracking-widest border-2 border-transparent group-hover:border-[--color-brand] transition-colors relative ${
                i % 3 === 0 ? 'aspect-[16/8]' : 'aspect-[4/3]'
              }`}
              aria-hidden="true"
              style="font-size: var(--text-xs);"
            >
              <span class="absolute top-6 left-6">/{String(project.data.order).padStart(2, '0')}</span>
              <span class="absolute top-6 right-6">{project.data.year}</span>
              [PLACEHOLDER · {project.data.title}]
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <h2
                class="font-display font-bold tracking-tight group-hover:text-[--color-brand] transition-colors"
                style="font-size: var(--text-lg);"
              >
                {project.data.title}
              </h2>
              <span class="font-mono text-xs text-[--color-muted]">{project.data.year}</span>
            </div>
            <p class="text-[--color-fg-soft] max-w-[55ch]">
              {project.data.excerpt}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.data.techStack.slice(0, 4).map((tech) => (
                <Tag label={tech} />
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
