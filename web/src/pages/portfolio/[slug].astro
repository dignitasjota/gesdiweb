---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceById } from '../../lib/collections';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio', (e) => e.data.status !== 'draft');
  const ordered = projects.sort((a, b) => a.data.order - b.data.order);
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: ordered[(i + 1) % ordered.length] },
  }));
}

interface Props {
  project: CollectionEntry<'portfolio'>;
  next: CollectionEntry<'portfolio'>;
}

import { creativeWorkSchema, breadcrumbSchema, SITE } from '../../lib/seo';

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const services = await Promise.all(data.servicesUsed.map((id) => getServiceById(id)));
const validServices = services.filter((s): s is NonNullable<typeof s> => Boolean(s));

const jsonLd = [
  creativeWorkSchema({
    slug: project.id,
    name: data.title,
    description: data.excerpt,
    year: data.year,
    client: data.client,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Trabajos', url: `${SITE.url}/portfolio` },
    { name: data.title, url: `${SITE.url}/portfolio/${project.id}` },
  ]),
];

// mark gigante = primera palabra del título (sin acentos para que cuadre el ancho)
const mark = data.title.split(' ')[0];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} · Trabajos · gesdiweb`}
  description={data.seoDescription ?? data.excerpt}
  ogImage={`/og/portfolio/${project.id}.png`}
  jsonLd={jsonLd}
>
  <article class="case-page">
    <header class="case-hero">
      <div class="case-breadcrumb">
        <a href="/portfolio">← Trabajos</a>
        <span class="sep">/</span>
        <span>{data.year}</span>
        <span class="sep">/</span>
        <span>{data.client}</span>
      </div>

      <h1 class="case-title">{data.title}</h1>

      <div class="case-meta">
        <div>
          <div class="cm-label">Cliente</div>
          <div class="cm-value">{data.client}</div>
        </div>
        <div>
          <div class="cm-label">Año</div>
          <div class="cm-value">{data.year}</div>
        </div>
        <div>
          <div class="cm-label">Servicios</div>
          <div class="cm-value">
            {
              validServices.map((s, i) => (
                <>
                  <a href={`/servicios/${s.id}`}>{s.data.title}</a>
                  {i < validServices.length - 1 ? ', ' : ''}
                </>
              ))
            }
          </div>
        </div>
        {
          data.url && (
            <div>
              <div class="cm-label">Web</div>
              <div class="cm-value">
                <a href={data.url} target="_blank" rel="nofollow noopener noreferrer">
                  {data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗
                </a>
              </div>
            </div>
          )
        }
      </div>
    </header>

    <div class="case-hero-media" style="background: var(--color-brand);">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? `${data.title} — captura del proyecto`}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1440px) 1440px, 100vw"
            class="case-hero-img"
            loading="eager"
          />
        ) : (
          <span class="mark">{mark}</span>
        )
      }
    </div>

    <div class="case-body">
      <section class="case-section">
        <div class="case-text-block">
          <h2>Caso de estudio</h2>
          <div class="case-prose">
            <Content />
          </div>
        </div>
      </section>

      {
        data.gallery && data.gallery.length > 0 && (
          <section class="case-section">
            <div class="case-gallery">
              {data.gallery.map((img, i) => (
                <div class="gb gb-wide">
                  <Image
                    src={img}
                    alt={`${data.title} — vista ${i + 1}`}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 1440px) 1440px, 100vw"
                    class="case-gallery-img"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section class="case-section">
        <h2 class="case-tech-label">// Stack técnico</h2>
        <div class="tech-grid">
          {
            data.techStack.map((tech, i) => (
              <div class="tech-cell">
                <span class="idx">/{String(i + 1).padStart(2, '0')}</span>
                <span>{tech}</span>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <nav aria-label="Proyecto siguiente" class="case-next">
      <div>
        <div class="cn-label">// siguiente proyecto</div>
        <a class="case-next-link" href={`/portfolio/${next.id}`}>
          <span class="cn-name">{next.data.title} →</span>
        </a>
      </div>
      <a class="case-next-thumb" href={`/portfolio/${next.id}`} aria-hidden="true" tabindex="-1">
        {
          next.data.cover ? (
            <Image
              src={next.data.cover}
              alt=""
              widths={[280, 560]}
              sizes="280px"
              class="case-next-img"
            />
          ) : (
            <span>{next.data.title.split(' ')[0]}</span>
          )
        }
      </a>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  /* Prose styling para el cuerpo MDX del caso */
  .case-prose h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-fg);
  }
  .case-prose h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
  }
  .case-prose p {
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 1.2rem;
    color: var(--color-fg);
    max-width: 65ch;
  }
  .case-prose ul,
  .case-prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
    color: var(--color-fg);
  }
  .case-prose li {
    margin-bottom: 0.5rem;
    line-height: 1.55;
  }
  .case-prose strong {
    font-weight: 600;
  }
  .case-prose a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .case-prose a:hover {
    text-decoration-thickness: 2px;
  }
</style>

<style>
  .case-hero {
    padding: 60px 32px 50px;
    border-bottom: 1px solid var(--color-border);
    max-width: var(--container-max);
    margin-inline: auto;
  }
  @media (min-width: 800px) {
    .case-hero {
      padding: 80px 32px 60px;
    }
  }
  .case-breadcrumb {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 40px;
  }
  .case-breadcrumb a:hover {
    color: var(--color-brand);
  }
  .case-breadcrumb .sep {
    color: var(--color-muted);
    opacity: 0.4;
  }
  .case-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 11rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 50px;
  }
  .case-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 800px) {
    .case-meta {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }
  .case-meta .cm-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 10px;
  }
  .case-meta .cm-value {
    font-size: 15px;
    line-height: 1.4;
  }
  .case-meta .cm-value a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .case-meta .cm-value a:hover {
    text-decoration-thickness: 2px;
  }

  .case-hero-media {
    height: 64vh;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .case-hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.06) 0 2px,
      transparent 2px 18px
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  :global(.case-hero-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }
  .case-hero-media .mark {
    font-family: var(--font-display);
    font-size: clamp(8rem, 26vw, 26rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.95);
    position: relative;
    z-index: 1;
  }

  .case-body {
    padding: 100px 32px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  @media (max-width: 800px) {
    .case-body {
      padding: 60px 20px;
    }
  }
  .case-section {
    margin-bottom: 100px;
  }
  .case-section:last-child {
    margin-bottom: 0;
  }

  .case-text-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .case-text-block {
      grid-template-columns: 220px 1fr;
      gap: 60px;
      padding-top: 40px;
    }
  }
  .case-text-block > h2 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .case-tech-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 32px;
  }

  .case-gallery {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .gb {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-bg-soft);
  }
  .gb-wide {
    aspect-ratio: 16 / 10;
  }
  :global(.case-gallery-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .tech-cell {
    padding: 24px 18px;
    border-bottom: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    transition: color 0.4s var(--ease);
  }
  .tech-cell::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-brand);
    transform: translateY(100%);
    transition: transform 0.5s var(--ease);
    z-index: 0;
  }
  .tech-cell:hover::before {
    transform: translateY(0);
  }
  .tech-cell:hover {
    color: var(--color-fg-inverse);
  }
  .tech-cell > * {
    position: relative;
    z-index: 1;
  }
  .tech-cell .idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }
  .tech-cell:hover .idx {
    color: rgba(250, 250, 248, 0.75);
  }

  .case-next {
    padding: 60px 32px;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 32px;
    max-width: var(--container-max);
    margin-inline: auto;
  }
  @media (min-width: 800px) {
    .case-next {
      grid-template-columns: 1fr auto;
      padding: 80px 32px;
    }
  }
  .case-next .cn-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .case-next-link {
    display: block;
    color: var(--color-fg);
  }
  .case-next-link .cn-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    transition: color 0.3s var(--ease);
  }
  .case-next-link:hover .cn-name {
    color: var(--color-brand);
  }
  .case-next-thumb {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    background: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.5s var(--ease);
    color: rgba(255, 255, 255, 0.95);
  }
  .case-next-thumb:hover {
    transform: scale(1.04);
  }
  .case-next-thumb span {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  :global(.case-next-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
  }
</style>
