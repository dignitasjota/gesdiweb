---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marker from '../../components/ui/Marker.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import { getServiceById } from '../../lib/collections';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio', (e) => e.data.status !== 'draft');
  const ordered = projects.sort((a, b) => a.data.order - b.data.order);
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: ordered[(i + 1) % ordered.length] },
  }));
}

interface Props {
  project: CollectionEntry<'portfolio'>;
  next: CollectionEntry<'portfolio'>;
}

import {
  creativeWorkSchema,
  breadcrumbSchema,
  SITE,
} from '../../lib/seo';

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const services = await Promise.all(
  data.servicesUsed.map((id) => getServiceById(id)),
);
const validServices = services.filter((s): s is NonNullable<typeof s> => Boolean(s));

const jsonLd = [
  creativeWorkSchema({
    slug: project.id,
    name: data.title,
    description: data.excerpt,
    year: data.year,
    client: data.client,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Portfolio', url: `${SITE.url}/portfolio` },
    { name: data.title, url: `${SITE.url}/portfolio/${project.id}` },
  ]),
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} · Portfolio · gesdiweb`}
  description={data.seoDescription ?? data.excerpt}
  jsonLd={jsonLd}
>
  <article>
    <header class="container-fluid pt-12 md:pt-20 pb-12 md:pb-20">
      <Marker label={`portfolio · ${data.year}`} />

      <h1
        class="mt-8 font-display font-bold tracking-[-0.025em] leading-[0.95] max-w-[20ch]"
        style="font-size: var(--text-3xl);"
      >
        {data.title}
      </h1>

      <p
        class="mt-8 max-w-2xl text-[--color-fg-soft] leading-relaxed"
        style="font-size: var(--text-lg);"
      >
        {data.excerpt}
      </p>
    </header>

    <div class="container-fluid pb-16 md:pb-24">
      {data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? `${data.title} — captura del proyecto`}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1280px) 1280px, 100vw"
          class="aspect-[16/9] w-full rounded-2xl object-cover border border-[--color-border]"
          loading="eager"
        />
      ) : (
        <div
          class="aspect-[16/9] bg-[--color-brand-soft] rounded-2xl border-2 border-[--color-brand] flex items-center justify-center text-[--color-brand-hover] font-mono uppercase tracking-widest"
          aria-hidden="true"
        >
          [PLACEHOLDER · cover hero]
        </div>
      )}
    </div>

    <section class="border-y border-[--color-border]">
      <div class="container-fluid py-12 md:py-16 grid grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted]">cliente</p>
          <p class="mt-2 text-base">{data.client}</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted]">año</p>
          <p class="mt-2 text-base">{data.year}</p>
        </div>
        <div class="col-span-2">
          <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted]">servicios</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {validServices.map((s) => (
              <a href={`/servicios/${s.id}`}>
                <Tag label={s.data.title} variant="brand" />
              </a>
            ))}
          </div>
        </div>
        {data.url && (
          <div class="col-span-2 md:col-span-4 pt-4 border-t border-[--color-border-soft]">
            <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted]">visitar web</p>
            <a
              href={data.url}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="mt-2 inline-flex items-center gap-2 text-base text-[--color-fg] hover:text-[--color-brand-hover] transition-colors group"
            >
              <span class="underline decoration-[--color-brand] decoration-2 underline-offset-4">
                {data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>

    <section class="container-fluid section-spacing grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <Marker label="caso de estudio" />
        <h2
          class="mt-6 font-display font-bold tracking-tight leading-tight"
          style="font-size: var(--text-xl);"
        >
          Cómo lo abordamos
        </h2>
      </div>
      <div class="md:col-span-8 prose-mimic max-w-3xl">
        <Content />
      </div>
    </section>

    {data.gallery && data.gallery.length > 0 && (
      <section class="container-fluid pb-20 md:pb-32">
        <Marker label="galería" />
        <h2
          class="mt-6 font-display font-bold tracking-tight leading-tight"
          style="font-size: var(--text-xl);"
        >
          Más vistas del proyecto
        </h2>
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
          {data.gallery.map((img, i) => (
            <Image
              src={img}
              alt={`${data.title} — vista ${i + 1}`}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[16/9] w-full rounded-2xl object-cover border border-[--color-border]"
              loading="lazy"
            />
          ))}
        </div>
      </section>
    )}

    <section class="bg-[--color-bg-soft] border-y border-[--color-border-soft]">
      <div class="container-fluid section-spacing">
        <Marker label="stack técnico" />
        <h2
          class="mt-6 font-display font-bold tracking-tight leading-tight"
          style="font-size: var(--text-xl);"
        >
          Tecnologías utilizadas
        </h2>
        <div class="mt-10 flex flex-wrap gap-3">
          {data.techStack.map((tech) => (
            <Tag label={tech} />
          ))}
        </div>
      </div>
    </section>

    <section class="container-fluid section-spacing">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-end">
        <div class="md:col-span-7">
          <Marker label="¿siguiente paso?" />
          <h2
            class="mt-6 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[18ch]"
            style="font-size: var(--text-2xl);"
          >
            ¿Tu proyecto, el próximo?
          </h2>
        </div>
        <div class="md:col-span-5 flex md:justify-end">
          <Button href="/contacto" variant="primary" size="lg">Hablemos</Button>
        </div>
      </div>
    </section>

    <nav aria-label="Proyecto siguiente" class="border-t border-[--color-border]">
      <a
        href={`/portfolio/${next.id}`}
        class="group block container-fluid py-12 md:py-16 transition-colors"
      >
        <span class="font-mono text-xs uppercase tracking-widest text-[--color-muted]">
          siguiente proyecto
        </span>
        <p
          class="mt-4 font-display font-bold tracking-tight leading-tight group-hover:text-[--color-brand] transition-colors"
          style="font-size: var(--text-2xl);"
        >
          {next.data.title} →
        </p>
      </a>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  .prose-mimic h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: var(--text-lg);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-mimic h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-mimic p {
    color: var(--color-fg-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .prose-mimic ul,
  .prose-mimic ol {
    padding-left: 1.5rem;
    color: var(--color-fg-soft);
    margin-bottom: 1rem;
  }
  .prose-mimic li {
    margin-bottom: 0.5rem;
  }
  .prose-mimic strong {
    color: var(--color-fg);
  }
  .prose-mimic a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-mimic a:hover {
    color: var(--color-brand);
  }
</style>
