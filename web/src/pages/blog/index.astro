---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marker from '../../components/ui/Marker.astro';
import Tag from '../../components/ui/Tag.astro';
import { getAllPosts, formatDateLong } from '../../data/posts';

const allPosts = getAllPosts();
const [featuredPost, ...rest] = allPosts;
---

<BaseLayout
  title="Blog · gesdiweb"
  description="Artículos sobre SEO técnico, diseño web, rendimiento y estrategia digital."
>
  <section class="container-fluid pt-12 md:pt-20 pb-16 md:pb-24">
    <Marker label="03.blog" />
    <h1
      class="mt-8 font-display font-bold tracking-tight leading-[0.95] max-w-[16ch]"
      style="font-size: var(--text-3xl);"
    >
      Pensamiento<br />
      <span class="text-[--color-brand]">aplicado</span>.
    </h1>
    <p class="mt-8 max-w-2xl text-lg text-[--color-fg-soft] leading-relaxed">
      Artículos breves sobre lo que vamos aprendiendo: SEO técnico, rendimiento,
      diseño y operación de proyectos digitales.
    </p>
  </section>

  {featuredPost && (
    <section class="border-t border-[--color-border]">
      <a
        href={`/blog/${featuredPost.slug}`}
        class="group block container-fluid py-16 md:py-24"
      >
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
          <div
            class="md:col-span-7 aspect-[16/9] bg-[--color-bg-soft] border border-[--color-border] rounded-lg flex items-center justify-center text-[--color-muted] font-mono text-sm uppercase tracking-widest group-hover:border-[--color-fg] transition-colors"
            aria-hidden="true"
          >
            [PLACEHOLDER · cover destacado]
          </div>
          <div class="md:col-span-5 flex flex-col gap-5">
            <div class="flex items-center gap-3 flex-wrap">
              {featuredPost.categories.map((cat) => (
                <Tag label={cat} variant="brand" />
              ))}
              <span class="font-mono text-xs text-[--color-muted]">
                · {featuredPost.readingMinutes} min lectura
              </span>
            </div>
            <h2
              class="font-display font-bold tracking-tight leading-tight group-hover:text-[--color-brand] transition-colors"
              style="font-size: var(--text-2xl);"
            >
              {featuredPost.title}
            </h2>
            <p class="text-[--color-fg-soft] text-base md:text-lg max-w-prose">
              {featuredPost.excerpt}
            </p>
            <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted] mt-auto">
              <time datetime={featuredPost.publishedAt}>
                {formatDateLong(featuredPost.publishedAt)}
              </time>
            </p>
          </div>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="border-t border-[--color-border]">
      <div class="container-fluid py-16 md:py-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
          {rest.map((post) => (
            <a href={`/blog/${post.slug}`} class="group flex flex-col gap-5">
              <div
                class="aspect-[4/3] bg-[--color-bg-soft] border border-[--color-border] rounded-lg flex items-center justify-center text-[--color-muted] font-mono text-xs uppercase tracking-widest group-hover:border-[--color-fg] transition-colors"
                aria-hidden="true"
              >
                [PLACEHOLDER · cover]
              </div>
              <div class="flex items-center gap-3 flex-wrap">
                {post.categories.slice(0, 1).map((cat) => (
                  <Tag label={cat} variant="brand" />
                ))}
                <span class="font-mono text-xs text-[--color-muted]">
                  · {post.readingMinutes} min
                </span>
              </div>
              <h2
                class="font-display font-bold tracking-tight leading-tight group-hover:text-[--color-brand] transition-colors"
                style="font-size: var(--text-lg);"
              >
                {post.title}
              </h2>
              <p class="text-sm text-[--color-fg-soft] line-clamp-3">
                {post.excerpt}
              </p>
              <p class="font-mono text-xs uppercase tracking-widest text-[--color-muted] mt-auto">
                <time datetime={post.publishedAt}>{formatDateLong(post.publishedAt)}</time>
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
