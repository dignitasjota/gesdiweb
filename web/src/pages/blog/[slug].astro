---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateLong, isoDate } from '../../lib/collections';
import { blogPostingSchema, breadcrumbSchema, SITE } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.status !== 'draft');
  const ordered = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
  return ordered.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: ordered.filter((p) => p.id !== post.id).slice(0, 2),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const jsonLd = [
  blogPostingSchema({
    slug: post.id,
    title: data.title,
    description: data.excerpt,
    publishedAt: data.publishedAt,
    author: data.author,
    keywords: [...data.categories, ...data.tags],
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Blog', url: `${SITE.url}/blog` },
    { name: data.title, url: `${SITE.url}/blog/${post.id}` },
  ]),
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} · Blog · gesdiweb`}
  description={data.seoDescription ?? data.excerpt}
  ogImage={`/og/blog/${post.id}.png`}
  ogType="article"
  publishedTime={data.publishedAt.toISOString()}
  articleAuthor={data.author}
  jsonLd={jsonLd}
>
  <article class="post-page">
    <header class="post-hero">
      <div class="post-breadcrumb">
        <a href="/blog">← Blog</a>
        <span class="sep">/</span>
        {data.categories[0] && <span>{data.categories[0]}</span>}
        <span class="sep">/</span>
        <time datetime={isoDate(data.publishedAt)}>{formatDateLong(data.publishedAt)}</time>
      </div>

      <h1 class="post-title">{data.title}</h1>

      <p class="post-excerpt">{data.excerpt}</p>

      <div class="post-meta">
        <div class="bf-tags">
          {data.categories.map((cat) => <span class="bf-tag">{cat}</span>)}
        </div>
        <div class="post-meta-info">
          <span>{data.readingMinutes} min lectura</span>
          <span>·</span>
          <span>{data.author}</span>
        </div>
      </div>
    </header>

    {
      data.cover && (
        <div class="post-cover">
          <Image
            src={data.cover}
            alt={data.coverAlt ?? data.title}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1440px) 1440px, 100vw"
            class="post-cover-img"
            loading="eager"
          />
        </div>
      )
    }

    <div class="post-body-wrap">
      <div class="post-body">
        <Content />

        {
          data.tags.length > 0 && (
            <div class="post-tags">
              <span class="lbl">// tags</span>
              <div class="post-tags-list">
                {data.tags.map((tag) => (
                  <span class="post-tag">{tag}</span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="post-related">
          <div class="post-related-inner">
            <div class="post-related-head">
              <div>
                <div class="post-related-eyebrow">
                  <span class="dot" aria-hidden="true" />
                  Seguir leyendo
                </div>
                <h2 class="post-related-title">
                  Artículos <em>relacionados</em>.
                </h2>
              </div>
              <a class="post-related-cta" href="/blog">
                Ver todos →
              </a>
            </div>

            <div class="post-related-grid">
              {related.map((p, i) => (
                <a class="blog-card" href={`/blog/${p.id}`}>
                  <div class="blog-card-media">
                    {p.data.cover ? (
                      <Image
                        src={p.data.cover}
                        alt={p.data.coverAlt ?? p.data.title}
                        widths={[400, 600, 800]}
                        sizes="(min-width: 768px) 50vw, 100vw"
                        class="blog-card-img"
                        loading="lazy"
                      />
                    ) : (
                      <span class="blog-card-mark">{String(i + 1).padStart(2, '0')}</span>
                    )}
                  </div>
                  <div class="blog-card-meta">
                    <time datetime={isoDate(p.data.publishedAt)}>
                      {formatDateLong(p.data.publishedAt)}
                    </time>
                    {p.data.categories?.[0] && <span class="bc-cat">{p.data.categories[0]}</span>}
                  </div>
                  <h3 class="bc-title">{p.data.title}</h3>
                  <p class="bc-excerpt">{p.data.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-top: 0;
  }
  .post-hero {
    padding: 60px 32px 40px;
    max-width: 920px;
    margin-inline: auto;
  }
  @media (min-width: 800px) {
    .post-hero {
      padding: 80px 32px 50px;
    }
  }
  .post-breadcrumb {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 40px;
  }
  .post-breadcrumb a:hover {
    color: var(--color-brand);
  }
  .post-breadcrumb .sep {
    color: var(--color-muted);
    opacity: 0.4;
  }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
  }
  .post-excerpt {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    color: var(--color-muted);
    max-width: 50ch;
    margin-bottom: 32px;
  }
  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 600px) {
    .post-meta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .bf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bf-tag {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-brand-soft);
    color: var(--color-brand-hover);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post-meta-info {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    display: flex;
    gap: 8px;
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    max-width: 1280px;
    margin: 0 auto 40px;
    padding: 0 32px;
    position: relative;
  }
  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .post-body-wrap {
    padding: 40px 32px 80px;
  }
  @media (min-width: 800px) {
    .post-body-wrap {
      padding: 60px 32px 120px;
    }
  }
  .post-body {
    max-width: 65ch;
    margin: 0 auto;
  }

  .post-tags {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .post-tags .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    display: block;
    margin-bottom: 12px;
  }
  .post-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .post-tag {
    padding: 6px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
  }

  .post-related {
    padding: 80px 32px;
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
  }
  .post-related-inner {
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .post-related-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 50px;
  }
  @media (min-width: 800px) {
    .post-related-head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }
  .post-related-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .post-related-eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-brand);
  }
  .post-related-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .post-related-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg);
    padding: 12px 22px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
    flex-shrink: 0;
  }
  .post-related-cta:hover {
    background: var(--color-fg);
    color: var(--color-fg-inverse);
  }
  .post-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 700px) {
    .post-related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .blog-card {
    display: block;
    color: var(--color-fg);
  }
  .blog-card-media {
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    background: var(--color-brand);
    position: relative;
    overflow: hidden;
    transition: transform 0.5s var(--ease);
  }
  .blog-card:hover .blog-card-media {
    transform: translateY(-4px);
  }
  :global(.blog-card-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }
  .blog-card-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 5rem;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.04em;
  }
  .blog-card-meta {
    display: flex;
    gap: 12px;
    margin: 14px 0 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .bc-cat {
    color: var(--color-brand);
  }
  .bc-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
    transition: color 0.3s var(--ease);
  }
  .blog-card:hover .bc-title {
    color: var(--color-brand);
  }
  .bc-excerpt {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<style is:global>
  .post-body h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.15;
  }
  .post-body h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .post-body p {
    line-height: 1.75;
    margin-bottom: 1.25rem;
    font-size: 17px;
    color: var(--color-fg);
  }
  .post-body ul,
  .post-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-fg);
  }
  .post-body li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .post-body strong {
    font-weight: 600;
  }
  .post-body a {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .post-body a:hover {
    color: var(--color-brand-hover);
  }
  .post-body code {
    background: var(--color-bg-soft);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.95em;
    font-family: var(--font-mono);
  }
  .post-body img {
    border-radius: 4px;
    margin: 1.5rem 0;
  }
  .post-body blockquote {
    border-left: 3px solid var(--color-brand);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-fg-soft);
  }
</style>
