---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateLong, isoDate } from '../../lib/collections';
import { blogPostingSchema, breadcrumbSchema, SITE } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.status !== 'draft');
  const ordered = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
  return ordered.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      next: ordered[(i + 1) % ordered.length],
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'>;
}

const { post, next } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

// TOC = h2 del cuerpo (los h2 del MDX llevan un slug auto-generado por
// el plugin de Astro; los pintamos numerados 01, 02, ...).
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = [
  blogPostingSchema({
    slug: post.id,
    title: data.title,
    description: data.excerpt,
    publishedAt: data.publishedAt,
    author: data.author,
    keywords: [...data.categories, ...data.tags],
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Blog', url: `${SITE.url}/blog` },
    { name: data.title, url: `${SITE.url}/blog/${post.id}` },
  ]),
];

const authorInitials = data.author
  .split(' ')
  .map((s) => s[0] ?? '')
  .join('')
  .slice(0, 2)
  .toUpperCase();

const category = data.categories?.[0] ?? 'Artículo';
const categoryMark = category[0]?.toUpperCase() ?? 'G';
const palette = ['#76c2da', '#0a0a0a', '#5fb3cf', '#1a1a1a'];
// Color derivado del slug para que sea estable entre vistas
const colorSeed = post.id.split('').reduce((s, c) => s + c.charCodeAt(0), 0);
const color = palette[colorSeed % palette.length];
const onDark = color === '#0a0a0a' || color === '#1a1a1a';
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} · Blog · gesdiweb`}
  description={data.seoDescription ?? data.excerpt}
  ogImage={`/og/blog/${post.id}.png`}
  ogType="article"
  publishedTime={data.publishedAt.toISOString()}
  articleAuthor={data.author}
  jsonLd={jsonLd}
>
  <div class="post-progress" data-post-progress aria-hidden="true"></div>

  <article class="post-page">
    <section class="post-hero">
      <div class="post-breadcrumb">
        <a href="/">Inicio</a>
        <span class="sep">/</span>
        <a href="/blog">Blog</a>
        <span class="sep">/</span>
        <span class="pill">{category}</span>
      </div>

      <div class="post-cat-pill">
        <span class="dot" aria-hidden="true"></span>
        {category} · {data.readingMinutes} min de lectura
      </div>

      <h1 class="post-title">{data.title}</h1>

      <div class="post-meta">
        <div class="author">
          <div class="author-avatar">{authorInitials}</div>
          <span>Por <strong>{data.author}</strong></span>
        </div>
        <span
          >Publicado <strong
            ><time datetime={isoDate(data.publishedAt)}>{formatDateLong(data.publishedAt)}</time
            ></strong
          ></span
        >
        <span><strong>{data.readingMinutes} min</strong> lectura</span>
        {
          data.tags.length > 0 && (
            <span>
              Tags: <strong>{data.tags.slice(0, 3).join(', ')}</strong>
            </span>
          )
        }
      </div>
    </section>

    <div class="post-hero-image-wrap">
      <div class="post-hero-image" style={`background: ${color};`}>
        {
          data.cover ? (
            <Image
              src={data.cover}
              alt={data.coverAlt ?? data.title}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 1440px) 1280px, 100vw"
              class="post-hero-img"
              loading="eager"
            />
          ) : (
            <span class="mark" style={onDark ? 'color:#fafaf8;' : 'color:#fff;'}>
              {categoryMark}
            </span>
          )
        }
      </div>
    </div>

    <div class="post-body">
      {
        toc.length > 1 && (
          <aside class="post-toc" aria-label="Índice del artículo">
            <h4>En este post</h4>
            <ol>
              {toc.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`}>
                    <span class="idx">{String(i + 1).padStart(2, '0')}.</span>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <div class:list={['post-content', { 'with-toc': toc.length > 1 }]}>
        <p class="post-intro">{data.excerpt}</p>

        <div class="post-prose">
          <Content />
        </div>
      </div>

      <aside class="post-rail" aria-label="Metadatos del artículo">
        {
          data.tags.length > 0 && (
            <div>
              <h4>Tags</h4>
              <div class="tags">
                {data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          )
        }

        <div>
          <h4>Compartir</h4>
          <div class="share">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(`${SITE.url}/blog/${post.id}`)}`}
              target="_blank"
              rel="noopener nofollow">Twitter <span>→</span></a
            >
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${SITE.url}/blog/${post.id}`)}`}
              target="_blank"
              rel="noopener nofollow">LinkedIn <span>→</span></a
            >
            <a href="#" data-copy-link>Copiar link <span>→</span></a>
          </div>
        </div>

        <div>
          <h4>¿Te ha gustado?</h4>
          <p class="rail-pitch">Si lo que has leído te suena familiar, cuéntanos tu proyecto.</p>
          <a href="/contacto" class="rail-cta">Hablemos →</a>
        </div>
      </aside>
    </div>

    <section class="post-end">
      <div class="post-author-card">
        <div class="post-author-avatar">{authorInitials}</div>
        <div class="post-author-body">
          <div class="author-role">Estudio gesdiweb</div>
          <h3>{data.author}</h3>
          <p>
            Llevamos desde 2009 ayudando a negocios reales a tener una presencia digital que de
            verdad posiciona. Sin humo, sin maquillaje. Si te ha interesado este artículo,
            escríbenos.
          </p>
          <div class="links">
            <a href="/contacto">Contactar →</a>
            <a href={`mailto:hola@gesdiweb.es?subject=Sobre%20${encodeURIComponent(data.title)}`}>
              hola@gesdiweb.es →
            </a>
          </div>
        </div>
      </div>

      {
        next && (
          <a class="post-next-link" href={`/blog/${next.id}`}>
            <div>
              <div class="cn-label">Siguiente artículo →</div>
              <div class="cn-title">{next.data.title}</div>
            </div>
            <div
              class="post-next-thumb"
              style={`background: ${palette[(colorSeed + 1) % palette.length]};`}
            >
              {next.data.cover ? (
                <Image
                  src={next.data.cover}
                  alt=""
                  widths={[180, 360]}
                  sizes="180px"
                  class="post-next-img"
                />
              ) : (
                <span>{(next.data.categories?.[0] ?? 'G')[0]?.toUpperCase()}</span>
              )}
            </div>
          </a>
        )
      }
    </section>
  </article>
</BaseLayout>

<style>
  /* Reading progress bar */
  .post-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-brand);
    z-index: 200;
    width: 0%;
    transition: width 0.1s linear;
  }

  .post-page {
    padding-top: 0;
  }

  /* Hero */
  .post-hero {
    padding: 50px 32px 50px;
    border-bottom: 1px solid var(--color-border);
    max-width: var(--container-max);
    margin: 0 auto;
  }
  @media (min-width: 800px) {
    .post-hero {
      padding: 80px 32px 60px;
    }
  }
  .post-breadcrumb {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 36px;
  }
  .post-breadcrumb a:hover {
    color: var(--color-brand);
  }
  .post-breadcrumb .sep {
    color: var(--color-muted);
    opacity: 0.4;
  }
  .post-breadcrumb .pill {
    padding: 4px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-fg);
  }

  .post-cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-brand) 12%, var(--color-bg));
    border: 1px solid color-mix(in oklab, var(--color-brand) 30%, var(--color-border));
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 28px;
    width: fit-content;
    color: var(--color-fg);
  }
  .post-cat-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6.5vw, 6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 22ch;
    margin-bottom: 40px;
  }

  .post-meta {
    display: flex;
    gap: 16px 28px;
    flex-wrap: wrap;
    padding: 22px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .post-meta strong {
    color: var(--color-fg);
    font-weight: 500;
  }
  .post-meta .author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .post-meta .author-avatar {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0;
  }

  /* Hero image */
  .post-hero-image-wrap {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 32px;
  }
  @media (max-width: 800px) {
    .post-hero-image-wrap {
      padding: 0 20px;
    }
  }
  .post-hero-image {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
  }
  .post-hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.06) 0 2px,
      transparent 2px 22px
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  :global(.post-hero-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }
  .post-hero-image .mark {
    font-family: var(--font-display);
    font-size: clamp(8rem, 26vw, 28rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  /* Article body — 3 columnas en desktop */
  .post-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 60px 32px 80px;
  }
  @media (min-width: 1100px) {
    .post-body {
      grid-template-columns: 200px minmax(0, 720px) 200px;
      gap: 60px;
      padding: 100px 32px;
    }
  }
  @media (max-width: 800px) {
    .post-body {
      padding: 50px 20px 70px;
    }
  }

  .post-toc {
    font-family: var(--font-mono);
    font-size: 11px;
    align-self: start;
  }
  @media (min-width: 1100px) {
    .post-toc {
      position: sticky;
      top: 110px;
    }
  }
  .post-toc h4 {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .post-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-toc li {
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .post-toc a {
    color: var(--color-fg);
    display: flex;
    gap: 8px;
    line-height: 1.4;
  }
  .post-toc a:hover {
    color: var(--color-brand);
  }
  .post-toc .idx {
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .post-content {
    min-width: 0;
  }

  /* Intro con drop cap Instrument Serif italic */
  .post-intro {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    padding-bottom: 40px;
    margin-bottom: 50px;
    border-bottom: 1px solid var(--color-border);
  }
  .post-intro::first-letter {
    font-family: var(--font-serif);
    font-size: 4em;
    font-style: italic;
    font-weight: 400;
    color: var(--color-brand);
    float: left;
    line-height: 0.85;
    padding-right: 14px;
    padding-top: 6px;
  }

  /* Right rail */
  .post-rail {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-self: start;
  }
  @media (min-width: 1100px) {
    .post-rail {
      position: sticky;
      top: 110px;
    }
  }
  .post-rail h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 12px;
    font-weight: 500;
  }
  .post-rail .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .post-rail .tag {
    padding: 5px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .post-rail .share {
    display: flex;
    flex-direction: column;
  }
  .post-rail .share a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-fg);
    transition: color 0.3s var(--ease);
  }
  .post-rail .share a:hover {
    color: var(--color-brand);
  }
  .post-rail .rail-pitch {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
    margin-bottom: 12px;
  }
  .post-rail .rail-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--color-fg);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg);
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .post-rail .rail-cta:hover {
    background: var(--color-fg);
    color: var(--color-fg-inverse);
  }

  /* End block */
  .post-end {
    border-top: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-brand) 4%, var(--color-bg));
  }
  .post-author-card {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 60px 32px;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 800px) {
    .post-author-card {
      padding: 80px 32px;
      grid-template-columns: 120px 1fr;
      gap: 32px;
    }
  }
  .post-author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-fg-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  @media (min-width: 800px) {
    .post-author-avatar {
      width: 120px;
      height: 120px;
      font-size: 32px;
    }
  }
  .post-author-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .post-author-body .author-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .post-author-body p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-fg);
    max-width: 60ch;
    margin-bottom: 18px;
  }
  .post-author-body .links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .post-author-body .links a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 2px;
    color: var(--color-fg);
    transition: color 0.3s var(--ease);
  }
  .post-author-body .links a:hover {
    color: var(--color-brand);
  }

  .post-next-link {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 24px;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px 20px 60px;
    border-top: 1px solid var(--color-border);
    color: var(--color-fg);
    transition: padding 0.3s var(--ease);
  }
  @media (min-width: 800px) {
    .post-next-link {
      grid-template-columns: 1fr auto;
      gap: 40px;
      padding: 60px 32px 80px;
    }
    .post-next-link:hover {
      padding-left: 48px;
    }
  }
  .post-next-link .cn-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 12px;
  }
  .post-next-link .cn-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    max-width: 24ch;
    transition: color 0.3s var(--ease);
  }
  .post-next-link:hover .cn-title {
    color: var(--color-brand);
  }
  .post-next-thumb {
    width: 100%;
    height: 100px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }
  @media (min-width: 800px) {
    .post-next-thumb {
      width: 180px;
      height: 120px;
    }
  }
  .post-next-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.06) 0 2px,
      transparent 2px 18px
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  :global(.post-next-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }
  .post-next-thumb span {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.95);
    position: relative;
    z-index: 1;
  }
</style>

<style is:global>
  /* Prose dentro del Content del MDX/MD */
  .post-prose {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-fg);
  }
  .post-prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 60px 0 24px;
    position: relative;
    scroll-margin-top: 140px;
    counter-increment: post-h2;
  }
  .post-prose h2::before {
    content: '/ ' counter(post-h2, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-brand);
    letter-spacing: 0.15em;
    margin-bottom: 14px;
    font-weight: 500;
    text-transform: uppercase;
  }
  .post-prose {
    counter-reset: post-h2;
  }
  .post-prose h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 500;
    margin: 36px 0 16px;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
