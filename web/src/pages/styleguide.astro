---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Styleguide · gesdiweb"
  description="Sistema de diseño interno: tokens, tipografía y patrones."
  noindex={true}
>
  <article class="sg-page">
    <section class="sg-section">
      <p class="sg-eyebrow">// Styleguide · v2</p>
      <h1 class="sg-title">
        Sistema de <em>diseño.</em>
      </h1>
      <p class="sg-lead">
        Tokens, tipografía y patrones que componen la web. Página interna no indexable.
      </p>
    </section>

    <section class="sg-section">
      <h2 class="sg-h2">Tipografía</h2>
      <div class="sg-block">
        <p class="sg-eyebrow">display-hero · clamp(64px → 224px)</p>
        <p
          style="font-size: var(--text-display-hero); font-family: var(--font-display); font-weight: 500; line-height: 0.92; letter-spacing: -0.04em;"
        >
          Espacio <em>amplio.</em>
        </p>
      </div>
      <div class="sg-block">
        <p class="sg-eyebrow">display · clamp(56px → 144px)</p>
        <p
          style="font-size: var(--text-display); font-family: var(--font-display); font-weight: 500; line-height: 0.95; letter-spacing: -0.04em;"
        >
          Tipografía <em>grande.</em>
        </p>
      </div>
      <div class="sg-block">
        <p class="sg-eyebrow">3xl · clamp(40px → 72px)</p>
        <p
          style="font-size: var(--text-3xl); font-family: var(--font-display); font-weight: 500; line-height: 0.98; letter-spacing: -0.03em;"
        >
          Sección <em>título.</em>
        </p>
      </div>
      <div class="sg-block">
        <p class="sg-eyebrow">2xl · clamp(28px → 44px)</p>
        <p style="font-size: var(--text-2xl); font-family: var(--font-display); font-weight: 500;">
          Bloque destacado.
        </p>
      </div>
      <div class="sg-block">
        <p class="sg-eyebrow">base · 15–17px</p>
        <p style="font-size: var(--text-base);">
          Cuerpo de texto en Space Grotesk regular. La altura de línea es 1.55 para asegurar buena
          legibilidad. Las cursivas usan <em>Instrument Serif</em> automáticamente cuando aparecen dentro
          de un heading. Fuera de heading, se aplica el helper{' '}
          <span class="serif-em">.serif-em</span>.
        </p>
      </div>
      <div class="sg-block">
        <p class="sg-eyebrow">mono · 10–13px</p>
        <p
          style="font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px;"
        >
          // 003 · MARCADOR MONOSPACE
        </p>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="sg-h2">Paleta</h2>
      <div class="sg-colors">
        <div class="sg-color" style="background: var(--color-bg);">
          <span>bg · #fafaf8</span>
        </div>
        <div class="sg-color" style="background: var(--color-bg-soft);">
          <span>bg-soft · #f5f5f2</span>
        </div>
        <div class="sg-color" style="background: var(--color-fg); color: var(--color-bg);">
          <span>fg · #0a0a0a</span>
        </div>
        <div class="sg-color" style="background: var(--color-brand); color: #fff;">
          <span>brand · #76c2da</span>
        </div>
        <div class="sg-color" style="background: var(--color-brand-soft);">
          <span>brand-soft</span>
        </div>
        <div class="sg-color" style="background: var(--color-muted);">
          <span>muted · #a7a7a7</span>
        </div>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="sg-h2">Patrones</h2>

      <p class="sg-eyebrow">marker-eye · monospace + dot brand</p>
      <div class="sg-block">
        <div
          style="display:inline-flex; align-items:center; gap:12px; font-family:var(--font-mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-muted);"
        >
          <span style="width:8px;height:8px;border-radius:999px;background:var(--color-brand);"
          ></span>
          Capacidades · 006
        </div>
      </div>

      <p class="sg-eyebrow">disco morphing decorativo (.disc-morph)</p>
      <div class="sg-block">
        <span class="disc-morph" style="display:inline-block;width:100px;height:100px;"></span>
      </div>

      <p class="sg-eyebrow">pill-button (mono uppercase)</p>
      <div class="sg-block sg-buttons">
        <a
          href="#"
          style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:999px;border:1px solid var(--color-fg);background:var(--color-fg);color:var(--color-bg);font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:0.1em;"
          >Primario</a
        >
        <a
          href="#"
          style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:999px;border:1px solid var(--color-border-strong);background:transparent;color:var(--color-fg);font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:0.1em;"
          >Secundario</a
        >
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .sg-page {
    padding: 80px 32px;
    max-width: 1100px;
    margin-inline: auto;
  }
  .sg-section {
    padding: 40px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sg-section:last-child {
    border-bottom: 0;
  }
  .sg-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .sg-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
  }
  .sg-lead {
    color: var(--color-muted);
    font-size: 17px;
    max-width: 60ch;
  }
  .sg-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }
  .sg-block {
    padding: 24px 0;
    border-top: 1px solid var(--color-border-soft);
  }
  .sg-colors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .sg-color {
    height: 100px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: flex-end;
    padding: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sg-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
