---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import ServicesNumberedList from '../components/sections/ServicesNumberedList.astro';
import PortfolioFeatured from '../components/sections/PortfolioFeatured.astro';
import Process from '../components/sections/Process.astro';
import BlogRecent from '../components/sections/BlogRecent.astro';
import { organizationSchema, webSiteSchema } from '../lib/seo';
---

<BaseLayout
  title="gesdiweb — diseño web y posicionamiento SEO"
  description="Agencia española de diseño web y posicionamiento SEO. Webs rápidas, accesibles y pensadas para crecer con tu negocio."
  jsonLd={[organizationSchema(), webSiteSchema()]}
>
  <Hero />

  <Marquee
    items={[
      { text: 'Diseño', em: 'web' },
      { text: 'Posicionamiento', em: 'SEO' },
      { text: 'Apps', em: 'móviles' },
      { text: 'Hosting', em: 'gestionado' },
      { text: 'Marketing', em: 'online' },
    ]}
  />

  <ServicesNumberedList />

  <Marquee
    variant="brand"
    items={[
      { text: 'Disponibles', em: 'Q3 2026' },
      { text: 'Trabajemos', em: 'juntos' },
      { text: 'España', em: '& remoto' },
      'hola@gesdiweb.es',
    ]}
  />

  <PortfolioFeatured />

  <Process />

  <BlogRecent />
</BaseLayout>
