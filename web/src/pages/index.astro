---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="min-h-screen flex flex-col items-center justify-center px-8 py-16">
    <p class="text-xs uppercase tracking-widest text-[--color-muted] mb-6 font-mono">
      // 00.00° fase 0 · setup base
    </p>

    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-center max-w-4xl">
      gesdiweb<span class="text-[--color-brand]">.</span>
    </h1>

    <p class="mt-4 text-lg text-[--color-fg-soft] text-center max-w-xl">
      Diseño web y posicionamiento SEO.
    </p>

    <p class="mt-12 text-sm text-[--color-muted] font-mono">
      hola mundo · build verificado
    </p>
  </main>
</BaseLayout>
