---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marker from '../../components/ui/Marker.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import type { IconName } from '../../components/ui/icon-names';
import { getOrderedServices } from '../../lib/collections';
import {
  itemListSchema,
  webPageSchema,
  breadcrumbSchema,
  SITE,
} from '../../lib/seo';

const services = await getOrderedServices();

const jsonLd = [
  webPageSchema({
    url: `${SITE.url}/servicios`,
    name: 'Servicios · gesdiweb',
    description:
      'SEO, apps móviles, hosting, marketing online y mantenimiento. Cinco servicios complementarios bajo un mismo equipo.',
  }),
  itemListSchema({
    name: 'Servicios de gesdiweb',
    items: services.map((s) => ({
      url: `${SITE.url}/servicios/${s.id}`,
      name: s.data.title,
    })),
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Servicios', url: `${SITE.url}/servicios` },
  ]),
];

const icons: Record<string, IconName> = {
  'posicionamiento-web': 'seo',
  'apps-moviles': 'mobile',
  'hosting-web': 'server',
  'marketing-online': 'megaphone',
  'mantenimiento-informatico': 'wrench',
  'diseno-web': 'browser',
};
---

<BaseLayout
  title="Servicios · gesdiweb"
  description="SEO, apps móviles, hosting, marketing online y mantenimiento. Cinco servicios complementarios bajo un mismo equipo."
  jsonLd={jsonLd}
>
  <section class="container-fluid pt-12 md:pt-20 pb-16 md:pb-24">
    <Marker label="01.servicios" />
    <h1
      class="mt-6 font-display font-bold tracking-[-0.025em] leading-[1] max-w-[18ch]"
      style="font-size: var(--text-3xl);"
    >
      Cinco servicios.<br />
      <span class="text-[--color-brand]">Un solo equipo</span>.
    </h1>
    <p
      class="mt-8 max-w-2xl text-[--color-fg-soft] leading-relaxed"
      style="font-size: var(--text-lg);"
    >
      No subcontratamos lo crítico. Cada servicio está pensado para encajar con
      los demás y para crecer contigo a lo largo de los años.
    </p>
  </section>

  <section class="container-fluid pb-20 md:pb-32">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {services.map((service) => (
        <a
          href={`/servicios/${service.id}`}
          class="group rounded-2xl p-7 md:p-9 flex flex-col gap-5 transition-all hover:-translate-y-1 bg-[--color-bg-soft] border border-[--color-border] hover:border-[--color-brand] hover:bg-[--color-brand-soft]"
        >
          <div class="flex items-start justify-between gap-4">
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[--color-brand-soft] text-[--color-brand-hover] group-hover:bg-[--color-brand] group-hover:text-[--color-fg-inverse] transition-colors"
              aria-hidden="true"
            >
              <Icon name={icons[service.id]} size={22} />
            </span>
            <span
              class="font-mono uppercase tracking-widest text-[--color-muted] group-hover:text-[--color-brand-hover] transition-colors"
              style="font-size: var(--text-xs);"
            >
              /{String(service.data.order).padStart(2, '0')}
            </span>
          </div>

          <h2
            class="font-display font-bold tracking-[-0.02em] leading-tight mt-2 group-hover:text-[--color-brand-hover] transition-colors"
            style="font-size: var(--text-xl);"
          >
            {service.data.title}
          </h2>

          <p class="text-[--color-fg-soft] leading-relaxed flex-1">
            {service.data.excerpt}
          </p>

          <div class="flex items-center justify-between pt-4 border-t border-[--color-border-soft]">
            <span
              class="font-mono uppercase tracking-widest text-[--color-fg-soft] group-hover:text-[--color-brand-hover] transition-colors"
              style="font-size: var(--text-xs);"
            >
              ver detalle
            </span>
            <span
              class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[--color-bg] text-[--color-fg] group-hover:bg-[--color-brand] group-hover:text-[--color-fg-inverse] transition-colors"
              aria-hidden="true"
            >
              <Icon name="arrow-up-right" size={14} strokeWidth={2.5} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-[--color-brand-soft] border-y border-[--color-brand]/20">
    <div class="container-fluid section-spacing text-center">
      <span
        class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[--color-brand] text-[--color-fg-inverse] mx-auto mb-6"
        aria-hidden="true"
      >
        <Icon name="sparkle" size={26} />
      </span>
      <h2
        class="font-display font-bold tracking-[-0.025em] leading-[1] max-w-[18ch] mx-auto"
        style="font-size: var(--text-2xl);"
      >
        ¿No estás seguro de <span class="text-[--color-brand-hover]">qué necesitas</span>?
      </h2>
      <p
        class="mt-6 max-w-xl mx-auto text-[--color-fg-soft] leading-relaxed"
        style="font-size: var(--text-base);"
      >
        Cuéntanos en una llamada de 40 minutos qué buscas y te diremos con
        honestidad qué servicio (o ninguno) encaja mejor.
      </p>
      <div class="mt-10">
        <Button href="/contacto" variant="primary" size="lg">Reservar llamada</Button>
      </div>
    </div>
  </section>
</BaseLayout>
