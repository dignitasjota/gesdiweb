---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrderedServices } from '../../lib/collections';
import { itemListSchema, webPageSchema, breadcrumbSchema, SITE } from '../../lib/seo';

const services = await getOrderedServices();

const jsonLd = [
  webPageSchema({
    url: `${SITE.url}/servicios`,
    name: 'Servicios · gesdiweb',
    description:
      'Diseño web, posicionamiento SEO, apps móviles, hosting, marketing online y mantenimiento. Seis servicios complementarios bajo un mismo equipo.',
  }),
  itemListSchema({
    name: 'Servicios de gesdiweb',
    items: services.map((s) => ({
      url: `${SITE.url}/servicios/${s.id}`,
      name: s.data.title,
    })),
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Servicios', url: `${SITE.url}/servicios` },
  ]),
];
---

<BaseLayout
  title="Servicios · gesdiweb"
  description="Diseño web, posicionamiento SEO, apps móviles, hosting, marketing online y mantenimiento. Seis servicios complementarios bajo un mismo equipo."
  jsonLd={jsonLd}
>
  <section class="list-hero">
    <div class="list-inner">
      <div class="list-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Capacidades · {String(services.length).padStart(3, '0')}
      </div>

      <h1 class="list-title">
        Seis servicios.<br />
        <em>Un solo equipo.</em>
      </h1>

      <p class="list-tagline">
        No subcontratamos lo crítico. Cada servicio está pensado para encajar con los demás y para
        crecer contigo a lo largo de los años.
      </p>
    </div>
  </section>

  <section class="services-list-wrap">
    <div class="services-inner">
      <div class="services-list">
        {
          services.map((s, i) => (
            <a class="service-row" href={`/servicios/${s.id}`}>
              <span class="service-num">{String(i + 1).padStart(2, '0')} —</span>
              <span class="service-name">{s.data.title}</span>
              <span class="service-desc">{s.data.excerpt}</span>
              <span class="service-arrow" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <path d="M5 17L17 5M17 5H7M17 5V15" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .list-hero {
    padding: 60px 32px 60px;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 800px) {
    .list-hero {
      padding: 80px 32px 80px;
    }
  }
  .list-inner {
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .list-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 40px;
  }
  .list-eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .list-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 11rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 32px;
  }

  .list-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    line-height: 1.3;
    font-weight: 400;
    color: var(--color-muted);
    max-width: 50ch;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .services-list-wrap {
    padding: 0 32px 80px;
  }
  .services-inner {
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .services-list {
    display: grid;
    grid-template-columns: 1fr;
  }
  .service-row {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding: 24px 0;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    color: var(--color-fg);
    transition: padding 0.5s var(--ease);
  }
  .service-row:first-child {
    border-top: 1px solid var(--color-border);
  }
  .service-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-brand);
    transform: translateY(100%);
    transition: transform 0.6s var(--ease);
    z-index: 0;
  }
  .service-row:hover::before {
    transform: translateY(0);
  }
  .service-row > * {
    position: relative;
    z-index: 1;
  }
  .service-row:hover {
    color: var(--color-fg-inverse);
    padding-left: 16px;
    padding-right: 16px;
  }
  .service-row:hover .service-num,
  .service-row:hover .service-desc {
    color: rgba(250, 250, 248, 0.85);
  }
  .service-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .service-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .service-desc {
    display: none;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 48ch;
  }
  .service-arrow {
    display: none;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    justify-self: end;
    transition: transform 0.4s var(--ease);
  }
  .service-row:hover .service-arrow {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  @media (min-width: 800px) {
    .service-row {
      grid-template-columns: 80px 1.4fr 2fr 80px;
      gap: 40px;
      padding: 32px 0;
    }
    .service-desc {
      display: block;
    }
    .service-arrow {
      display: flex;
    }
  }
</style>
