---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const services = await getCollection('services', (e) => e.data.status !== 'draft');
  const ordered = services.sort((a, b) => a.data.order - b.data.order);
  return ordered.map((service, i) => ({
    params: { slug: service.id },
    props: { service, next: ordered[(i + 1) % ordered.length] },
  }));
}

interface Props {
  service: CollectionEntry<'services'>;
  next: CollectionEntry<'services'>;
}

import { serviceSchema, breadcrumbSchema, SITE } from '../../lib/seo';

const { service, next } = Astro.props;
const { data } = service;

const jsonLd = [
  serviceSchema({
    slug: service.id,
    name: data.title,
    description: data.excerpt,
    features: data.features,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: SITE.url },
    { name: 'Servicios', url: `${SITE.url}/servicios` },
    { name: data.title, url: `${SITE.url}/servicios/${service.id}` },
  ]),
];

// Tomamos la última palabra del headline para hacerla serif italic
const headlineWords = data.headline.split(' ');
const headlineLead = headlineWords.slice(0, -1).join(' ');
const headlineEmph = headlineWords.slice(-1).join(' ').replace(/\.$/, '');

// Para el "mark" gigante decorativo del hero
const mark = data.title.split(' ')[0];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} · gesdiweb`}
  description={data.seoDescription ?? data.excerpt}
  ogImage={`/og/services/${service.id}.png`}
  jsonLd={jsonLd}
>
  <article class="svc-page">
    <header class="svc-hero">
      <div class="svc-eyebrow">
        <span>← <a href="/servicios">Servicios</a></span>
        <span class="pill">{String(data.order).padStart(2, '0')}</span>
        <span>{service.id}</span>
      </div>

      <h1 class="svc-title">
        {headlineLead}{' '}
        <em>{headlineEmph}.</em>
      </h1>

      <p class="svc-tagline">{data.excerpt}</p>

      <span class="svc-mark" aria-hidden="true">{mark}</span>
    </header>

    <div class="svc-body">
      <section class="svc-section">
        <div class="svc-prose">
          <h2>Lo que incluye</h2>
          <div class="svc-prose-text">
            <ul class="svc-deliv-list">
              {
                data.features.map((feature, i) => (
                  <li>
                    <span class="num">/{String(i + 1).padStart(2, '0')}</span>
                    <span>{feature}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="svc-section">
        <div class="svc-prose">
          <h2>Cómo trabajamos</h2>
          <div class="svc-prose-text">
            <ol class="svc-method">
              {
                data.approach.map((step, i) => (
                  <li>
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                    <p>{step}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="svc-section">
        <div class="svc-cta-box">
          <div class="svc-cta-eyebrow">
            <span class="dot" aria-hidden="true"></span>
            ¿Siguiente paso?
          </div>
          <h2 class="svc-cta-title">
            Una llamada de 40 minutos<br />
            <em>sin compromiso.</em>
          </h2>
          <a href="/contacto" class="svc-cta-btn">
            Hablemos
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <path d="M5 17L17 5M17 5H7M17 5V15" stroke="currentColor" stroke-width="1.6"></path>
            </svg>
          </a>
        </div>
      </section>
    </div>

    <nav aria-label="Servicio siguiente" class="svc-next">
      <a href={`/servicios/${next.id}`}>
        <span class="cn-label">// siguiente servicio</span>
        <p class="cn-name">{next.data.title} →</p>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .svc-page {
    padding-top: 0;
  }

  .svc-hero {
    padding: 60px 32px 60px;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    max-width: var(--container-max);
    margin-inline: auto;
  }
  @media (min-width: 800px) {
    .svc-hero {
      padding: 80px 32px 80px;
    }
  }
  .svc-eyebrow {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 40px;
  }
  .svc-eyebrow a:hover {
    color: var(--color-brand);
  }
  .svc-eyebrow .pill {
    padding: 4px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-fg);
  }

  .svc-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 12rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }

  .svc-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    line-height: 1.2;
    font-weight: 400;
    color: var(--color-muted);
    max-width: 32ch;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    position: relative;
    z-index: 1;
  }

  .svc-mark {
    position: absolute;
    right: -2vw;
    bottom: -8vw;
    font-family: var(--font-display);
    font-size: clamp(15rem, 40vw, 38rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--color-brand);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    text-transform: lowercase;
  }

  .svc-body {
    padding: 80px 32px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  @media (max-width: 800px) {
    .svc-body {
      padding: 60px 20px;
    }
  }
  .svc-section {
    margin-bottom: 80px;
  }
  .svc-section:last-child {
    margin-bottom: 0;
  }

  .svc-prose {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .svc-prose {
      grid-template-columns: 220px 1fr;
      gap: 60px;
      padding-top: 40px;
    }
  }
  .svc-prose h2 {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    font-weight: 500;
  }

  .svc-deliv-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .svc-deliv-list li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
    font-size: 16px;
    line-height: 1.5;
  }
  .svc-deliv-list li .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-brand-ink);
    letter-spacing: 0.08em;
  }

  .svc-method {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .svc-method li {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }
  .svc-method li .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.1em;
  }
  .svc-method li p {
    font-size: 16px;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }

  /* CTA box */
  .svc-cta-box {
    padding: 60px 0 20px;
    border-top: 1px solid var(--color-border);
  }
  .svc-cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 32px;
  }
  .svc-cta-eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-brand);
  }
  .svc-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
  }
  .svc-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 28px;
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-fg-inverse);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: background 0.3s var(--ease);
  }
  .svc-cta-btn:hover {
    background: var(--color-brand);
    color: var(--color-fg);
  }
  .svc-cta-btn svg {
    transition: transform 0.3s var(--ease);
  }
  .svc-cta-btn:hover svg {
    transform: rotate(-45deg);
  }

  /* next service */
  .svc-next {
    padding: 60px 32px;
    border-top: 1px solid var(--color-border);
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .svc-next a {
    display: block;
    color: var(--color-fg);
  }
  .cn-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .cn-name {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    transition: color 0.3s var(--ease);
  }
  .svc-next a:hover .cn-name {
    color: var(--color-brand);
  }
</style>
