---
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';
import SmoothScroll from '../components/animations/SmoothScroll.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  hideChrome?: boolean;
  /** Imagen para Open Graph y Twitter Card. Por defecto la global de la marca. */
  ogImage?: string;
  /** Tipo de Open Graph. 'website' por defecto, 'article' para posts. */
  ogType?: 'website' | 'article';
  /** Para artículos: fecha publicación ISO */
  publishedTime?: string;
  /** Para artículos: fecha modificación ISO */
  modifiedTime?: string;
  /** Para artículos: nombre del autor */
  articleAuthor?: string;
  /** Schemas JSON-LD a inyectar (array de objetos JS, NO strings). */
  jsonLd?: unknown[];
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = `Agencia española de ${SITE.tagline.toLowerCase()}. Webs rápidas, accesibles y pensadas para crecer.`,
  lang = 'es',
  noindex = false,
  hideChrome = false,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleAuthor,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage ?? SITE.defaultOgImage, SITE.url).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Iconos */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#77c2da" />
    <meta name="color-scheme" content="light" />

    {/* Canonical */}
    <link rel="canonical" href={canonical} />

    {/* Title + description */}
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Robots */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    {/* JSON-LD */}
    {jsonLd.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    ))}

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <SmoothScroll />

    {!hideChrome && <Header />}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {!hideChrome && <Footer />}
  </body>
</html>
