---
interface Props {
  number: string | number;
  class?: string;
}

const { number, class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center justify-center font-mono text-xs tracking-widest text-[--color-muted] ${className}`}
>
  /{String(number).padStart(2, '0')}
</span>
