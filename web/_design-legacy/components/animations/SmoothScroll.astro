---
/**
 * Wrapper que monta:
 *   - Lenis para smooth scroll global
 *   - IntersectionObserver para reveals al entrar en viewport
 *   - GSAP + ScrollTrigger solo para parallax scroll-linked
 *
 * Respeta prefers-reduced-motion: si está activo, ni Lenis ni los reveals
 * se inicializan (los elementos quedan visibles desde el primer paint
 * gracias al CSS de fallback).
 *
 * Para animar elementos al scroll, usar <Reveal> (no requiere GSAP, solo
 * CSS transitions disparadas por una clase). Para parallax usar
 * data-parallax="0.3" (sí requiere GSAP ScrollTrigger).
 */
---

<script>
  import Lenis from 'lenis';

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  let lenis: Lenis | null = null;

  async function setupAnimations() {
    if (reduceMotion) {
      // El CSS ya muestra todo. Nada que hacer.
      return;
    }

    // ── Lenis smooth scroll ────────────────────────────────────
    lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.4,
    });

    function raf(time: number) {
      if (lenis) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
    }
    requestAnimationFrame(raf);

    document.documentElement.classList.add('lenis-smooth');

    // ── Reveals con IntersectionObserver (sin GSAP) ────────────
    const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.revealDelay || 0);
          const isStagger = el.dataset.revealStagger === 'true';

          if (isStagger) {
            // Aplicar delay incremental a cada hijo
            const children = Array.from(el.children).filter(
              (c): c is HTMLElement => c instanceof HTMLElement,
            );
            children.forEach((child, i) => {
              child.style.setProperty(
                '--stagger-delay',
                `${delay + i * 80}ms`,
              );
            });
          } else if (delay > 0) {
            el.style.transitionDelay = `${delay}ms`;
          }

          el.classList.add('is-visible');
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );

    reveals.forEach((el) => io.observe(el));

    // ── Parallax con GSAP ScrollTrigger (lazy import) ──────────
    const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
    if (parallaxEls.length > 0) {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      // Sincronizar Lenis con ScrollTrigger
      if (lenis) lenis.on('scroll', ScrollTrigger.update);

      parallaxEls.forEach((el) => {
        const speed = Number(el.dataset.parallax || 0.3);
        gsap.to(el, {
          yPercent: -100 * speed,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement || el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });
    }
  }

  function cleanup() {
    if (lenis) {
      lenis.destroy();
      lenis = null;
    }
    document.documentElement.classList.remove('lenis-smooth');
  }

  // Setup inicial + reset en cada navegación con View Transitions
  setupAnimations();
  document.addEventListener('astro:before-swap', cleanup);
  document.addEventListener('astro:page-load', setupAnimations);
</script>
