---
import Marker from '../ui/Marker.astro';
import Icon from '../ui/Icon.astro';

const year = new Date().getFullYear();

const navColumns = [
  {
    title: 'Servicios',
    links: [
      { href: '/servicios/posicionamiento-web', label: 'Posicionamiento web' },
      { href: '/servicios/apps-moviles', label: 'Apps móviles' },
      { href: '/servicios/hosting-web', label: 'Hosting web' },
      { href: '/servicios/marketing-online', label: 'Marketing online' },
      { href: '/servicios/mantenimiento-informatico', label: 'Mantenimiento' },
    ],
  },
  {
    title: 'Estudio',
    links: [
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/blog', label: 'Blog' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/aviso-legal', label: 'Aviso legal' },
      { href: '/politica-privacidad', label: 'Política de privacidad' },
      { href: '/politica-cookies', label: 'Política de cookies' },
    ],
  },
];
---

<footer class="bg-[--color-bg-inverse] text-[--color-fg-inverse] relative">
  {/* Borde superior brand */}
  <div class="h-2 bg-[--color-brand]" aria-hidden="true"></div>

  <div class="container-fluid py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
      <div class="md:col-span-5 lg:col-span-6">
        <Marker label="hablemos" prefix="//" variant="inverse" />
        <h2
          class="mt-6 font-display font-bold tracking-[-0.025em] leading-[0.95]"
          style="font-size: var(--text-2xl);"
        >
          ¿Listo para que tu web<br />
          <span class="text-[--color-brand]">posicione</span> de verdad?
        </h2>

        <div class="mt-10 space-y-3 text-white/85" style="font-size: var(--text-sm);">
          <a
            href="mailto:hola@gesdiweb.es"
            class="inline-flex items-center gap-3 hover:text-[--color-brand] transition-colors"
          >
            <Icon name="mail" size={16} class="text-[--color-brand]" />
            hola@gesdiweb.es
          </a>
          <p class="flex items-center gap-3">
            <Icon name="pin" size={16} class="text-[--color-brand]" />
            España · Atención remota
          </p>
          <p class="flex items-center gap-3">
            <Icon name="clock" size={16} class="text-[--color-brand]" />
            Lunes a viernes · 09:00–18:00 (CET)
          </p>
        </div>
      </div>

      <div class="md:col-span-7 lg:col-span-6 grid grid-cols-2 md:grid-cols-3 gap-8">
        {navColumns.map((col) => (
          <nav aria-label={col.title}>
            <p class="font-mono text-xs uppercase tracking-widest text-[--color-brand] mb-5">
              {col.title}
            </p>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[--color-fg-inverse] hover:text-[--color-brand] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <hr class="border-white/10 mt-16 mb-8" />

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-[--color-muted]">
      <p>© {year} gesdiweb · Diseño web y posicionamiento SEO</p>
      <p class="font-mono uppercase tracking-widest inline-flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[--color-brand]" aria-hidden="true"></span>
        hecho en España
      </p>
    </div>
  </div>
</footer>
