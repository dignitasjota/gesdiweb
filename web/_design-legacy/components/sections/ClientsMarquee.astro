---
import Marker from '../ui/Marker.astro';

const placeholders = [
  '[CLIENTE 01]',
  '[CLIENTE 02]',
  '[CLIENTE 03]',
  '[CLIENTE 04]',
  '[CLIENTE 05]',
  '[CLIENTE 06]',
  '[CLIENTE 07]',
  '[CLIENTE 08]',
];

// Duplicado para loop continuo
const items = [...placeholders, ...placeholders];
---

<section
  class="bg-[--color-brand] text-[--color-fg-inverse] py-10 md:py-14 overflow-hidden border-y-4 border-[--color-brand-hover]"
>
  <div class="container-fluid mb-6 flex items-center justify-between gap-4">
    <Marker label="confían en nosotros" variant="inverse" class="text-white/70!" />
    <span class="font-mono uppercase tracking-widest text-white/70" style="font-size: var(--text-xs);">
      // 24 proyectos · 12 sectores
    </span>
  </div>

  <div class="relative">
    <div class="marquee-track items-center gap-16 md:gap-24 px-8 whitespace-nowrap">
      {items.map((label, i) => (
        <div class="flex items-center gap-16 md:gap-24 shrink-0">
          <span
            class="font-display font-bold tracking-tight uppercase text-[--color-fg-inverse]"
            style="font-size: var(--text-xl);"
          >
            {label}
          </span>
          <span
            class="text-[--color-fg-inverse]/40"
            style="font-size: var(--text-lg);"
            aria-hidden="true"
          >
            ✳
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
