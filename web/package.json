{
  "name": "gesdiweb-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "og": "node scripts/generate-og-images.mjs",
    "og:force": "node scripts/generate-og-images.mjs --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && git config core.hooksPath .husky 2>/dev/null || true"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,mjs,cjs,json,css,yml,yaml}": "prettier --write",
    "*.{md,mdx}": "prettier --write --prose-wrap preserve"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/node": "^10.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/instrument-serif": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.2.2",
    "lenis": "^1.3.23",
    "rehype-external-links": "^3.0.0",
    "resend": "^6.12.2",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "vite": "^7.3.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0"
  }
}
